---
import BaseLayout from '../layouts/BaseLayout.astro';
import { sitePath } from '../lib/urls';

// Course names are transcribed from the supplied academic record. Grades,
// credits and identifying fields are intentionally excluded from this page.
const groups = [
  {
    id: 'physics',
    number: '01',
    title: '物理与电磁建模',
    context: '从基础物理到电磁场、光学与现代理论。',
    courses: [
      '电磁学', '电动力学', '光学', '理论力学', '热力学与统计物理',
      '量子力学', '固体物理', '原子物理', '光电子学基础', '力学', '热学',
    ],
  },
  {
    id: 'mathematics',
    number: '02',
    title: '数学与数值计算',
    context: '用数学工具建立模型，并通过程序与仿真检验。',
    courses: [
      '数学物理方法', '计算物理', '概率论与随机过程', '线性代数',
      '复变函数', '高等数学', 'Matlab与物理实验仿真',
      '高级语言程序设计（C）', '高级语言课程设计', '物理计算与设计',
    ],
  },
  {
    id: 'systems',
    number: '03',
    title: '信号、电子与实验',
    context: '围绕信号链、传感器、电路及物理实验建立工程基础。',
    courses: [
      '信号与系统', '传感器原理及应用', '模拟电子技术基础',
      '电路分析基础', '电路基础实验', '数字电路与逻辑设计',
      '数字电路实验', '普通物理实验', '近代物理实验',
    ],
  },
  {
    id: 'extension',
    number: '04',
    title: '研究表达与拓展',
    context: '专业学习、研究表达与跨方向探索。',
    courses: [
      '学术基本要素：专业论文写作', '应用物理学专业英语',
      '应用物理学专业导论', '人工智能导论', 'TRIZ创新方法',
    ],
  },
];

const generalCourses = [
  '大学英语I', '大学英语II', '大学英语III', '大学英语IV', '大学英语口语',
  '大学体育I', '大学体育II', '大学体育III模块', '大学体育IV模块',
  '大学美育', '美术鉴赏', '数学文化', '数学大观',
  '创业基础', '大学生职业生涯规划', '大学生就业指导',
  '大学生心理健康教育', '大学生安全教育', '劳动教育',
  '军事理论', '军事技能', '认识实习',
  '思想道德与法治', '中国近现代史纲要', '马克思主义基本原理',
  '形势与政策1—6', '清史', '葡萄酒与西方文化', '企业绿色管理',
];
---

<BaseLayout
  title="课程基础 · Coursework"
  description="赵斐然的应用物理学本科课程，按与物理建模、电磁感知及自主系统研究的相关性整理，仅展示课程名称。"
  path="/coursework/"
>
  <div class="coursework-page">
    <header class="coursework-hero">
      <div class="shell">
        <nav class="coursework-breadcrumb" aria-label="面包屑导航">
          <a href={sitePath('/')}>首页</a><span aria-hidden="true">/</span><span aria-current="page">课程基础</span>
        </nav>
        <div class="hero-grid">
          <div>
            <p class="coursework-label">Coursework / Applied Physics</p>
            <h1>课程基础<span class="title-dot" aria-hidden="true">.</span></h1>
          </div>
          <div class="hero-copy">
            <p class="hero-lead">从基础物理到数值实验，<br />这些课程构成我进入当前研究方向的知识起点。</p>
            <p class="hero-note">依据已修课程整理，按与现有研究的相关性编排。这里只展示课程名称，不展示成绩、绩点或学分。</p>
          </div>
        </div>
        <nav class="course-nav" aria-label="课程分类">
          {groups.map((group) => <a href={`#${group.id}`}><span>{group.number}</span>{group.title}</a>)}
        </nav>
      </div>
    </header>

    {groups.map((group) => (
      <section class="course-group" id={group.id} aria-labelledby={`${group.id}-title`}>
        <div class="shell group-grid">
          <div class="group-heading">
            <span class="group-number">{group.number} / Coursework</span>
            <h2 id={`${group.id}-title`}>{group.title}</h2>
            <p>{group.context}</p>
          </div>
          <ol class="course-list">
            {group.courses.map((course, index) => (
              <li><span class="course-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span><span>{course}</span></li>
            ))}
          </ol>
        </div>
      </section>
    ))}

    <section class="general-section" aria-labelledby="general-heading">
      <div class="shell general-grid">
        <div><p class="group-number">Further study</p><h2 id="general-heading">通识与其他课程选录</h2></div>
        <details>
          <summary>查看通识课程名称 <span aria-hidden="true">＋</span></summary>
          <ul>{generalCourses.map((course) => <li>{course}</li>)}</ul>
        </details>
      </div>
    </section>

    <div class="shell course-footer"><p>课程顺序反映与当前研究方向的关联程度，不代表课程成绩或能力评级。</p><a href={sitePath('/#research-map')}>返回研究脉络 <span aria-hidden="true">↗</span></a></div>
  </div>
  <a href={sitePath('/')} class="floating-back" aria-label="返回上一页" onclick="if (document.referrer.includes(window.location.host)) { window.history.back(); return false; }">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M19 12H5M12 19l-7-7 7-7" />
    </svg>
    <span>返回</span>
  </a>
</BaseLayout>

<style>
  .coursework-page { background: var(--paper); }
  .coursework-hero { padding: clamp(2.3rem, 5vw, 4.5rem) 0 0; }
  .coursework-breadcrumb { display: flex; gap: .85rem; align-items: center; margin-bottom: clamp(3rem, 7vw, 6rem); color: var(--ink-soft); font-size: .85rem; }
  .coursework-breadcrumb a { color: var(--blue); }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, .88fr); gap: clamp(2rem, 6vw, 6rem); align-items: end; }
  .coursework-label, .group-number { display: block; color: var(--blue); font: 700 .72rem/1.5 var(--sans); letter-spacing: .15em; text-transform: uppercase; }
  h1 { margin: .8rem 0 0; font-size: clamp(3.2rem, 7vw, 6.3rem); font-weight: 400; letter-spacing: -.06em; color: var(--ink); }
  .title-dot { color: var(--blue); }
  .hero-copy { padding-bottom: .35rem; }
  .hero-lead { margin: 0; color: var(--blue); font: 400 clamp(1.2rem, 2vw, 1.65rem)/1.7 var(--serif); }
  .hero-note { margin: 1.3rem 0 0; max-width: 38rem; color: var(--ink-soft); font-size: .93rem; line-height: 1.75; }
  .course-nav { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0; margin-top: clamp(3rem, 7vw, 6rem); border-top: 1px solid var(--line); }
  .course-nav a { display: flex; align-items: center; gap: .65rem; min-height: 4.75rem; padding: .7rem 1rem; border-bottom: 1px solid var(--line-soft); color: var(--ink); font-weight: 600; text-decoration: none; transition: color .2s, background .2s; }
  .course-nav a:first-child { padding-left: 0; }
  .course-nav a:hover, .course-nav a:focus-visible { color: var(--blue); background: var(--blue-pale); }
  .course-nav a span { color: var(--blue); font-size: .72rem; letter-spacing: .06em; }
  .course-group { padding: clamp(3.3rem, 6vw, 5rem) 0; border-bottom: 1px solid var(--line); scroll-margin-top: 6rem; }
  .group-grid, .general-grid { display: grid; grid-template-columns: minmax(13rem, .9fr) minmax(0, 2fr); gap: clamp(2rem, 7vw, 7rem); }
  .group-heading h2, .general-grid h2 { margin: .75rem 0 1rem; color: var(--ink); font-size: clamp(1.55rem, 2.3vw, 2.2rem); font-weight: 400; }
  .group-heading p { max-width: 18rem; color: var(--ink-soft); font-size: .92rem; line-height: 1.8; }
  .course-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 1.9rem; list-style: none; margin: 0; padding: 0; }
  .course-list li { display: flex; align-items: baseline; gap: 1rem; min-width: 0; padding: 1rem 0; border-top: 1px solid var(--line-soft); color: var(--ink); font-size: 1.01rem; line-height: 1.6; }
  .course-number { flex: none; color: var(--ink-faint); font: 600 .69rem/1.6 var(--sans); font-variant-numeric: tabular-nums; }
  .general-section { padding: clamp(3rem, 5vw, 4rem) 0; border-bottom: 1px solid var(--line); background: var(--white); }
  .general-grid details { border-top: 1px solid var(--line); }
  .general-grid summary { display: flex; justify-content: space-between; align-items: center; min-height: 3.5rem; color: var(--blue); cursor: pointer; font-weight: 600; }
  .general-grid summary span { font-size: 1.3rem; font-weight: 400; transition: transform .2s; }
  .general-grid details[open] summary span { transform: rotate(45deg); }
  .general-grid ul { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .15rem 2rem; list-style: none; padding: 1rem 0 0; margin: 0; }
  .general-grid li { padding: .45rem 0; color: var(--ink-soft); font-size: .9rem; }
  .course-footer { display: flex; justify-content: space-between; align-items: center; gap: 2rem; padding-top: 2rem; padding-bottom: 4rem; color: var(--ink-soft); font-size: .86rem; }
  .course-footer p { margin: 0; }
  .course-footer a { flex: none; font-weight: 600; }
  @media (max-width: 760px) {
    .coursework-hero { padding-top: 2rem; }
    .coursework-breadcrumb { margin-bottom: 2.6rem; }
    .hero-grid, .group-grid, .general-grid { grid-template-columns: minmax(0, 1fr); gap: 1.25rem; }
    h1 { font-size: clamp(2.9rem, 12vw, 4.5rem); }
    .hero-lead { font-size: 1.2rem; }
    .course-nav { grid-template-columns: repeat(2, minmax(0, 1fr)); margin-top: 2.8rem; }
    .course-nav a { padding-left: .6rem; min-height: 3.5rem; font-size: .86rem; }
    .course-nav a:first-child { padding-left: .6rem; }
    .course-group { padding: 3rem 0; }
    .group-heading h2, .general-grid h2 { margin-bottom: .4rem; }
    .group-heading p { max-width: none; }
    .course-list { gap: 0 1rem; }
    .course-list li { font-size: .94rem; gap: .55rem; padding: .83rem 0; }
    .course-footer { align-items: flex-start; flex-direction: column; gap: 1rem; padding-bottom: 3rem; }
  }
  @media (max-width: 420px) {
    .course-list, .general-grid ul { grid-template-columns: minmax(0, 1fr); }
    .course-list li { padding: .66rem 0; }
    .hero-lead br { display: none; }
  }
  @media (prefers-reduced-motion: reduce) { .course-nav a, .general-grid summary span { transition: none; } }
</style>
