---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ResearchMap from '../components/ResearchMap.astro';
import EvidenceBlock from '../components/EvidenceBlock.astro';
import FigureFrame from '../components/FigureFrame.astro';
import { byId, projectUrl } from '../lib/content';

const [projects, evidence, figures, materials, maps, sites] = await Promise.all([
  getCollection('projects'), getCollection('evidence'), getCollection('figures'),
  getCollection('materials'), getCollection('maps'), getCollection('site')
]);
const p = byId(projects), e = byId(evidence), f = byId(figures), m = byId(materials);
const map = maps[0];
const profile = sites[0].data;
const emvision = p.get('emvision')!, lowalt = p.get('lowalt-md')!, emtrace = p.get('em-trace')!, quad = p.get('quadcontrol-lab')!;
---
<BaseLayout title="应用物理 · 计算电磁 · 智能感知" description="围绕电磁感知与无人系统，以可审计的物理模型、受控实验和明确的证据边界呈现四个研究项目。">
  <section class="hero" aria-labelledby="hero-title"><div class="shell hero-grid">
    <div><p class="eyebrow">{profile.publicName.zh} / Research Portfolio</p><h1 id="hero-title">从物理模型，到可审计的<span>研究证据。</span></h1><p class="hero-deck">{profile.statement.zh}</p><p class="hero-note">{profile.schoolWording.zh} · 计算电磁 · 智能感知</p>
      <div class="cta-row"><a class="button primary" href="#research-map">浏览研究脉络 <span aria-hidden="true">↓</span></a><a class="button subtle" href="/documents/research-overview.pdf" target="_blank" rel="noopener">研究概览 PDF ↗</a></div>
    </div>
    <aside class="hero-aside" aria-label="研究工作方式"><span class="aside-rule" aria-hidden="true"></span><p>Research approach</p><ol><li>明确物理与协议假设</li><li>构造可配对的数值实验</li><li>保留负结果与解释边界</li></ol></aside>
  </div></section>

  <ResearchMap map={map} />

  <section class="section flagship-section" id="projects" aria-labelledby="flagship-heading"><div class="shell">
    <div class="section-intro"><p class="eyebrow">02 / Flagship Study</p><h2 id="flagship-heading">EMvision <span class="heading-sub">受控识别实验</span></h2><p>{emvision.data.summary.zh}</p></div>
    <div class="feature-grid"><div class="feature-content"><p class="small-label">研究问题</p><p class="feature-question">{emvision.data.researchQuestion.zh}</p><EvidenceBlock evidence={e.get('EVM-02')!} compact /><p class="context-note">端点比较限定于固定合成测试域与配对协议；底层 canonical 结果已内部核验，公开入口为证据摘要。</p><a class="text-link" href={projectUrl('emvision')}>阅读 EMvision 项目与完整边界 <span aria-hidden="true">↗</span></a></div><FigureFrame figure={f.get('FIG-EVM-03')!} /></div>
  </div></section>

  <section class="section approach-section" id="approach" aria-labelledby="approach-heading"><div class="shell">
    <div class="section-intro"><p class="eyebrow">03 / Approach</p><h2 id="approach-heading">从模型到结论的每一步，都留下审计线索。</h2></div>
    <ol class="approach-grid"><li><span>01</span><h3>定义条件</h3><p>先冻结坐标、几何、传播、观测与训练协议，避免模糊的“效果提升”。</p></li><li><span>02</span><h3>构建对照</h3><p>用分层物理机制、全因子角点或确定性配对实验分离问题。</p></li><li><span>03</span><h3>报告边界</h3><p>把负结果、已更正解释、来源状态和不能外推的范围一同呈现。</p></li></ol>
  </div></section>

  <section class="section studies-section" aria-labelledby="studies-heading"><div class="shell">
    <div class="section-intro"><p class="eyebrow">04 / Connected Studies</p><h2 id="studies-heading">物理机制与工程基础</h2></div>
    <div class="study-grid"><article class="study"><div><p class="study-index">A / Physics Mechanism</p><h3>{lowalt.data.title.zh}</h3><p>{lowalt.data.summary.zh}</p><EvidenceBlock evidence={e.get('LOW-01')!} compact /><EvidenceBlock evidence={e.get('LOW-02')!} compact /><p class="context-note">共同增益与非共同复权重是不同的模型条件；R3 的负结果在项目页保留。</p><a class="text-link" href={projectUrl('lowalt-md')}>进入 LowAlt-MD <span aria-hidden="true">↗</span></a></div><FigureFrame figure={f.get('FIG-LOW-02')!} /></article>
      <article class="study"><div><p class="study-index">B / Engineering Foundation</p><h3>{emtrace.data.title.zh}</h3><p>{emtrace.data.summary.zh}</p><EvidenceBlock evidence={e.get('EMT-01')!} compact /><p class="context-note">方向与极化约定已更正；历史前向输入不构成正确后向定量微动验证。</p><a class="text-link" href={projectUrl('em-trace')}>进入 EM-Trace <span aria-hidden="true">↗</span></a></div></article></div>
  </div></section>

  <section class="section branch-section" aria-labelledby="branch-heading"><div class="shell branch-grid"><div><p class="eyebrow">05 / Autonomous Systems Branch</p><h2 id="branch-heading">QuadControl-Lab</h2><p class="lead">{quad.data.summary.zh}</p><EvidenceBlock evidence={e.get('QC-01')!} compact /><p class="context-note">固定合成、确定性、单 seed 配对轨迹；不作为实机稳定性或因果比例结论。</p><a class="text-link" href={projectUrl('quadcontrol-lab')}>查看独立分支 <span aria-hidden="true">↗</span></a></div><FigureFrame figure={f.get('FIG-QC-02')!} /></div></section>

  <section class="section about-section" id="about" aria-labelledby="about-heading"><div class="shell about-grid"><div><p class="eyebrow">06 / About</p><h2 id="about-heading">关于{profile.publicName.zh}</h2></div><div><p class="lead">{profile.researchIdentity.zh}</p><p>{profile.publicName.zh}，{profile.schoolWording.zh}。{profile.statement.zh}</p><p>四个项目共享审慎的证据呈现方式：每个数字都有协议上下文，每个图件都保留原始来源，纠错与负结果也可直接阅读。最终 CV 版本仍待确认。</p></div></div></section>

  <section class="section materials-section" id="materials" aria-labelledby="materials-heading"><div class="shell"><div class="section-intro"><p class="eyebrow">07 / Materials</p><h2 id="materials-heading">资料与公开入口</h2><p>以下是当前已核对的公开材料。正式 CV 待版本确定后补入。</p></div><div class="material-grid"><a class="material-item" href={m.get('overview')!.data.publicUrl} target="_blank" rel="noopener"><span>01 / PDF</span><strong>研究概览</strong><small>两页研究项目概览 ↗</small></a><a class="material-item" href={m.get('portfolio')!.data.publicUrl} target="_blank" rel="noopener noreferrer"><span>02 / GitHub</span><strong>Research-Portfolio</strong><small>公开摘要与精选代码 ↗</small></a><div class="material-item pending" aria-label="CV 版本待确认"><span>03 / CV</span><strong>学术 CV</strong><small>版本待确认</small></div></div></div></section>

  <section class="section contact-section" id="contact" aria-labelledby="contact-heading"><div class="shell contact-grid"><div><p class="eyebrow">08 / Contact</p><h2 id="contact-heading">继续交流</h2><p>科研交流可通过电子邮件联系，也可从公开研究仓库了解项目背景与证据摘要。</p><a class="contact-email" href={`mailto:${profile.publicEmail}`}>{profile.publicEmail}</a></div><div class="contact-actions"><a class="button primary" href={`mailto:${profile.publicEmail}`}>发送邮件 ↗</a><a class="button subtle" href={profile.githubUrl} target="_blank" rel="noopener noreferrer">查看 GitHub ↗</a></div></div></section>
</BaseLayout>
