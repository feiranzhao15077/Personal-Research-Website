---
import { sitePath } from '../lib/urls';
import { getCollection } from 'astro:content';
import Hero from '../components/Hero.astro';
import ResearchSummary from '../components/ResearchSummary.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import ResearchMap from '../components/ResearchMap.astro';
import EvidenceBlock from '../components/EvidenceBlock.astro';
import FigureFrame from '../components/FigureFrame.astro';
import FlagshipResult from '../components/FlagshipResult.astro';
import ElectromagneticWave from '../components/ElectromagneticWave.astro';
import { byId, projectUrl } from '../lib/content';

const [projects, evidence, figures, materials, maps, sites] = await Promise.all([
  getCollection('projects'), getCollection('evidence'), getCollection('figures'),
  getCollection('materials'), getCollection('maps'), getCollection('site')
]);
const p = byId(projects), e = byId(evidence), f = byId(figures), m = byId(materials);
const map = maps[0];
const profile = sites[0].data;
const cv = m.get(profile.cvMaterialId)?.data;
const cvUrl = cv?.accessStatus === 'PUBLIC' && cv.publicUrl ? sitePath(cv.publicUrl) : undefined;
const initialRelease = import.meta.env.RELEASE_MODE === 'production' && import.meta.env.RELEASE_TARGET === 'initial';
const emvision = p.get('emvision')!, lowalt = p.get('lowalt-md')!, emtrace = p.get('em-trace')!, quad = p.get('quadcontrol-lab')!;

// Decorative geometries describe the method stages, not experimental measurements.
const approachStages = [
  { title: '物理问题', text: 'LowAlt-MD · 低空传播如何改变谱结构', paths: ['M 2 20 H 6 C 11 20 11 8 16 8 S 21 32 26 32 S 31 20 36 20 H 38'], dots: [] },
  { title: '数学建模', text: 'LowAlt-MD · M0–M3 分层机制', paths: ['M 4 28 Q 20 0 36 28', 'M 10 31 L 20 12 L 30 31'], dots: [] },
  { title: '数值实现', text: 'EM-Trace · CAD、CST 与复场提取', paths: ['M 6 27 L 15 16 L 25 23 L 34 10'], dots: [[6, 27], [15, 16], [25, 23], [34, 10]] },
  { title: '受控实验', text: 'EMvision · C/G/P 全因子配对', paths: ['M 5 12 H 35 M 5 20 H 35 M 5 28 H 35', 'M 13 9 V 15 M 25 17 V 23 M 19 25 V 31'], dots: [] },
  { title: '证据审计', text: 'EM-Trace · 方向与极化纠错', paths: ['M 20 6 V 34 M 6 20 H 34', 'M 12 9 H 9 V 12 M 28 9 H 31 V 12 M 9 28 V 31 H 12 M 31 28 V 31 H 28'], dots: [[20, 20]] },
  { title: '可复核工程', text: '公开摘要与精选代码；不等于完整复现包', paths: ['M 29 9 H 9 V 31 H 29', 'M 16 16 H 25 M 16 23 H 25 M 33 15 V 25'], dots: [] },
];
---
<BaseLayout title="应用物理 · 计算电磁 · 智能感知" description="围绕电磁感知与无人系统，以可审计的物理模型、受控实验和明确的证据边界呈现四个研究项目。">
  <Hero profile={profile} />

  <ResearchMap map={map} />

  <section class="section approach-section" id="approach" aria-labelledby="approach-heading"><div class="shell">
    <div class="approach-heading-layout">
      <div class="section-intro"><p class="eyebrow">02 / Approach</p><h2 id="approach-heading">研究方法是一条可追溯的链。</h2><p>从问题定义到证据审计，每一环都对应具体项目中的工作。</p></div>
      <div class="approach-wave"><ElectromagneticWave /></div>
    </div>
    <ol class="approach-grid">
      {approachStages.map((stage, index) => (
        <li tabindex="0">
          <svg class="approach-track" viewBox="0 0 240 36" preserveAspectRatio="none" aria-hidden="true" focusable="false">
            <path class="approach-track-base" d="M 0 18 H 240" />
            <path class="approach-track-pulse" d="M 0 18 H 240" pathLength="1" />
          </svg>
          <svg class="approach-symbol" viewBox="0 0 40 40" fill="none" aria-hidden="true" focusable="false">
            {stage.paths.map((path) => <path d={path} />)}
            {stage.dots.map(([cx, cy]) => <circle cx={cx} cy={cy} r="2" />)}
          </svg>
          <span>{String(index + 1).padStart(2, '0')}</span>
          <h3>{stage.title}</h3>
          <p>{stage.text}</p>
        </li>
      ))}
    </ol>
  </div></section>

  <section class="section flagship-section" id="projects" aria-labelledby="flagship-heading"><div class="shell">
    <div class="section-intro"><p class="eyebrow">03 / Flagship Study</p><h2 id="flagship-heading">EMvision <span class="heading-sub">受控识别实验</span></h2><ResearchSummary projectId="emvision" /><p>{emvision.data.summary.zh}</p></div>
    <div class="flagship-overview"><div class="feature-content"><p class="small-label">研究问题与协议</p><p class="feature-question">{emvision.data.researchQuestion.zh}</p><dl class="factor-list"><div><dt>C</dt><dd>训练端通道匹配</dd></div><div><dt>G</dt><dd>生成器族匹配</dd></div><div><dt>P</dt><dd>参数分布匹配</dd></div></dl></div><FlagshipResult evidence={e.get('EVM-02')!} /></div>
    <div class="flagship-figure"><FigureFrame figure={f.get('FIG-EVM-03')!} /><a class="text-link" href={projectUrl('emvision')}>阅读 EMvision 的协议、结果与完整边界 <span aria-hidden="true">↗</span></a></div>
  </div></section>

  <section class="section studies-section" aria-labelledby="studies-heading"><div class="shell">
    <div class="section-intro"><p class="eyebrow">04 / Connected Studies</p><h2 id="studies-heading">物理机制与工程基础</h2></div>
    <div class="study-grid"><article class="study"><div><p class="study-index">A / Physics Mechanism</p><h3>{lowalt.data.title.zh}</h3><ResearchSummary projectId="lowalt-md" /><p>{lowalt.data.summary.zh}</p><EvidenceBlock evidence={e.get('LOW-01')!} compact /><EvidenceBlock evidence={e.get('LOW-02')!} compact /><p class="context-note">共同增益与非共同复权重是不同的模型条件；R3 的负结果在项目页保留。</p><a class="text-link" href={projectUrl('lowalt-md')}>进入 LowAlt-MD <span aria-hidden="true">↗</span></a></div></article>
      <article class="study"><div><p class="study-index">B / Engineering Foundation</p><h3>{emtrace.data.title.zh}</h3><ResearchSummary projectId="em-trace" /><p>{emtrace.data.summary.zh}</p><EvidenceBlock evidence={e.get('EMT-01')!} compact /><p class="context-note">方向与极化约定已更正；历史前向输入不构成正确后向定量微动验证。</p><a class="text-link" href={projectUrl('em-trace')}>进入 EM-Trace <span aria-hidden="true">↗</span></a></div></article></div>
    <div class="study-evidence"><FigureFrame figure={f.get('FIG-LOW-02')!} /></div>
  </div></section>

  <section class="section branch-section" aria-labelledby="branch-heading"><div class="shell branch-grid"><div><p class="eyebrow">05 / Autonomous Systems Branch</p><h2 id="branch-heading">QuadControl-Lab</h2><ResearchSummary projectId="quadcontrol-lab" /><p class="lead">{quad.data.summary.zh}</p><EvidenceBlock evidence={e.get('QC-01')!} compact /><p class="context-note">固定合成、确定性、单 seed 配对轨迹；不作为实机稳定性或因果比例结论。</p><a class="text-link" href={projectUrl('quadcontrol-lab')}>查看独立分支 <span aria-hidden="true">↗</span></a></div><FigureFrame figure={f.get('FIG-QC-02')!} /></div></section>

  <section class="section about-section" id="about" aria-labelledby="about-heading"><div class="shell about-grid"><div><p class="eyebrow">06 / About</p><h2 id="about-heading">关于{profile.publicName.zh}</h2><p class="research-motto"><span>格物穷理<span class="motto-comma">，</span></span><span>致数博学</span></p></div><div><p class="lead">{profile.researchIdentity.zh}</p><p>{profile.publicName.zh}，{profile.schoolWording.zh}。{profile.statement.zh}</p><p>四个项目共享审慎的证据呈现方式：每个数字都有协议上下文，每个图件都保留原始来源，纠错与负结果也可直接阅读。{cvUrl ? <a href={cvUrl} target="_blank" rel="noopener">查看学术 CV ↗</a> : !initialRelease && '最终 CV 版本仍待确认。'}</p></div></div></section>

  <section class="section materials-section" id="materials" aria-labelledby="materials-heading"><div class="shell"><div class="section-intro"><p class="eyebrow">07 / Materials</p><h2 id="materials-heading">资料与公开入口</h2><p>以下是当前已核对的公开材料。{!cvUrl && !initialRelease && '正式 CV 待版本确定后补入。'}</p></div><div class:list={['material-grid', { 'two-items': initialRelease }]}><a class="material-item" href={sitePath(m.get('overview')!.data.publicUrl)} target="_blank" rel="noopener"><span>01 / PDF</span><strong>研究概览</strong><small>两页研究项目概览 ↗</small></a><a class="material-item" href={sitePath(m.get('portfolio')!.data.publicUrl)} target="_blank" rel="noopener noreferrer"><span>02 / GitHub</span><strong>Research-Portfolio</strong><small>公开摘要与精选代码 ↗</small></a>{cvUrl ? <div class="material-item"><span>03 / CV</span><strong>{cv!.label.zh}</strong><a href={cvUrl} target="_blank" rel="noopener">打开 CV ↗</a><a href={cvUrl} download="Zhaofeiran_CV.pdf">下载 CV ↓</a></div> : !initialRelease && <div class="material-item pending" aria-label="CV 版本待确认"><span>03 / CV</span><strong>学术 CV</strong><small>版本待确认</small></div>}</div></div></section>

  <section class="section contact-section" id="contact" aria-labelledby="contact-heading"><div class="shell contact-grid"><div><p class="eyebrow">08 / Contact</p><h2 id="contact-heading">继续交流</h2><p>科研交流可通过电子邮件联系，也可从公开研究仓库了解项目背景与证据摘要。</p><a class="contact-email" href={`mailto:${profile.publicEmail}`}>{profile.publicEmail}</a></div><div class="contact-actions"><a class="button primary" href={`mailto:${profile.publicEmail}`}>发送邮件 ↗</a><a class="button subtle" href={profile.githubUrl} target="_blank" rel="noopener noreferrer">查看 GitHub ↗</a></div></div></section>
</BaseLayout>

<style>
  .flagship-section .section-intro {
    max-width: 58rem;
    margin-bottom: clamp(2rem, 3.5vw, 3rem);
  }
  .flagship-section .section-intro h2 {
    font-size: clamp(1.9rem, 3vw, 2.4rem);
    line-height: 1.25;
    margin-bottom: 1.25rem;
  }
  .flagship-section .heading-sub {
    font-size: 1rem;
    margin-left: .8rem;
  }
  .flagship-section :global(.research-summary) { max-width: 76ch; margin-block: 0 1rem; }
  .flagship-section :global(.narrative-title) { font-size: 1.05rem; line-height: 1.6; margin-bottom: .6rem; }
  .flagship-section :global(.narrative-copy),
  .flagship-section .section-intro > p:last-child { font-size: 1rem; line-height: 1.8; }
  .flagship-section .section-intro > p:last-child { max-width: 76ch; margin-top: 1rem; }
  .flagship-section .flagship-overview {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2rem, 4vw, 3.5rem);
  }
  .flagship-section .feature-content { min-width: 0; padding-top: 1rem; border-top: 1px solid var(--blue); }
  .flagship-section .small-label { margin-bottom: 1rem; }
  .flagship-section .feature-question { font: 400 1.125rem/1.8 var(--serif); margin-bottom: 1.5rem; }
  .flagship-section .factor-list { margin-top: 0; gap: .65rem; font-size: .95rem; }
  .flagship-section :global(.flagship-result) { min-width: 0; margin-left: 0; padding: 1rem 0 0; }
  .flagship-section :global(.result-label) { font-size: .85rem; margin-bottom: 1.15rem; }
  .flagship-section :global(.endpoint-line) { gap: 1rem; }
  .flagship-section :global(.endpoint-arrow) { margin: 0; font-size: 1.35rem; }
  .flagship-section :global(.endpoint-line strong) { font-size: clamp(1.8rem, 2.5vw, 2.2rem); }
  .flagship-section :global(.difference-line) { font-size: .9rem; gap: .5rem 1.5rem; }
  .flagship-section :global(.difference-line strong) { font-size: 1.15rem; }
  .flagship-section :global(.result-context),
  .flagship-section :global(.result-source),
  .flagship-section :global(.result-boundary) { font-size: .9rem; line-height: 1.75; }
  @media (max-width: 900px) {
    .flagship-section .flagship-overview { grid-template-columns: 1fr; gap: 2rem; }
  }
  @media (max-width: 370px) {
    .flagship-section .heading-sub { margin: .4rem 0 0; }
  }
  .approach-heading-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 400px);
    align-items: center;
    gap: clamp(1.5rem, 4vw, 3rem);
    margin-bottom: clamp(2rem, 5vw, 4rem);
  }
  .approach-heading-layout .section-intro { margin-bottom: 0; }
  .approach-wave { min-width: 0; }
  @media (min-width: 701px) and (max-width: 1000px) {
    .approach-heading-layout { grid-template-columns: minmax(0, 1fr) minmax(0, 280px); gap: 1.25rem; }
  }
  .approach-grid li {
    position: relative;
    min-width: 0;
    border-top: 0;
    padding-top: 3rem;
  }
  .approach-track {
    position: absolute;
    left: 0;
    top: 0;
    width: calc(100% + 1rem);
    height: 36px;
    fill: none;
    stroke: var(--blue);
    pointer-events: none;
  }
  .approach-grid li:last-child .approach-track { width: 100%; }
  .approach-track-base { stroke-width: 1; opacity: .25; }
  .approach-track-pulse {
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-dasharray: .012 .988;
    stroke-dashoffset: 1;
    opacity: 0;
  }
  .approach-symbol {
    position: absolute;
    top: 0;
    left: 0;
    width: 36px;
    height: 36px;
    background: var(--paper-deep);
    color: var(--blue);
    stroke: currentColor;
    stroke-width: 1.1;
    stroke-linecap: round;
    stroke-linejoin: round;
    transform-origin: center;
    transition: color .25s ease, transform .25s cubic-bezier(.16, 1, .3, 1);
    pointer-events: none;
  }
  .approach-symbol circle { fill: var(--paper-deep); }
  .approach-grid li:focus-visible { outline: 1px solid var(--blue); outline-offset: 6px; }
  .approach-grid li:focus-visible .approach-symbol { color: var(--blue-deep); transform: scale(1.08); }
  .approach-grid li:focus-visible .approach-track-pulse { animation: approach-trace .45s ease-out both; }
  @media (hover: hover) and (pointer: fine) {
    .approach-grid li:hover .approach-symbol { color: var(--blue-deep); transform: scale(1.08); }
    .approach-grid li:hover .approach-track-pulse { animation: approach-trace .45s ease-out both; }
  }
  @keyframes approach-trace {
    0% { stroke-dashoffset: 1; opacity: 0; }
    15% { opacity: .9; }
    80% { opacity: .9; }
    100% { stroke-dashoffset: 0; opacity: 0; }
  }
  @media (max-width: 1100px) {
    .approach-grid li:nth-child(3) .approach-track { width: 100%; }
  }
  @media (max-width: 700px) {
    .approach-heading-layout { grid-template-columns: 1fr; gap: .75rem; }
    .approach-wave { width: min(100%, 340px); justify-self: end; }
    .approach-grid li { padding: 0 0 0 3.5rem; }
    .approach-track { display: none; }
    .approach-grid li::before {
      content: '';
      position: absolute;
      left: 17.5px;
      top: 18px;
      bottom: calc(-1.5rem - 18px);
      border-left: 1px solid color-mix(in srgb, var(--blue) 25%, transparent);
      pointer-events: none;
    }
    .approach-grid li:last-child::before { display: none; }
    .approach-grid li:focus-visible .approach-symbol { transform: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .approach-symbol { transition: none; }
    .approach-grid li:hover .approach-symbol,
    .approach-grid li:focus-visible .approach-symbol { transform: none; }
    .approach-track-pulse { display: none; }
  }
  @media (min-width: 1024px) {
    .materials-section > .shell {
      display: grid;
      grid-template-columns: minmax(14rem, .85fr) minmax(0, 2.15fr);
      align-items: start;
      gap: clamp(2rem, 4vw, 3.5rem);
    }
    .materials-section .section-intro { margin-bottom: 0; }
    .materials-section .material-grid { min-width: 0; }
    .materials-section .material-item { min-height: 168px; padding: 1rem; }
    .materials-section .material-item strong { font-size: 1.15rem; }
  }
  .research-motto {
    position: relative;
    width: fit-content;
    margin: 2rem 0 0;
    padding-bottom: 1.1rem;
    color: var(--blue);
    font: 400 clamp(1.65rem, 2.3vw, 2.2rem)/1.6 'KaiTi', 'STKaiti', 'Kaiti SC', var(--serif);
    letter-spacing: .16em;
  }
  .research-motto > span { display: block; }
  .research-motto > span:last-child {
    margin-left: 1.25em;
    transition: transform .45s ease, color .45s ease;
  }
  .research-motto::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 42%;
    height: 1px;
    background: var(--line);
    transform-origin: left;
    transition: transform .45s ease, background-color .45s ease;
  }
  .motto-comma {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }
  .about-section:focus-within .research-motto::after { background: var(--blue); }
  @media (hover: hover) and (pointer: fine) {
    .research-motto:hover > span:last-child { transform: translateX(3px); color: var(--blue-deep); }
    .research-motto:hover::after { transform: scaleX(1.5); background: var(--blue); }
  }
  @media (prefers-reduced-motion: reduce) {
    .research-motto > span:last-child, .research-motto::after,
    .research-motto:hover > span:last-child, .research-motto:hover::after { transition: none; transform: none; }
  }
  .study-evidence {
    margin-top: clamp(1.5rem, 3vw, 2.5rem);
    padding-top: clamp(1rem, 2vw, 1.5rem);
    border-top: 1px solid var(--line);
  }
  .study-evidence :global(.figure-frame) {
    max-width: 52rem;
    margin-inline: auto;
  }
  .study-evidence :global(.figure-image-link img) {
    height: auto;
    max-height: none;
  }
  .study-evidence :global(figcaption) {
    max-width: 80ch;
  }
</style>
