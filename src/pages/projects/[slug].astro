---
import { sitePath } from '../../lib/urls';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ResearchSummary from '../../components/ResearchSummary.astro';
import { projectNarratives } from '../../lib/projectNarratives';
import EvidenceBlock from '../../components/EvidenceBlock.astro';
import FigureFrame from '../../components/FigureFrame.astro';
import { ordered, projectUrl } from '../../lib/content';
import '../../styles/project-reading.css';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({ params: { slug: project.data.slug }, props: { project } }));
}
interface Props { project: CollectionEntry<'projects'>; }
const { project } = Astro.props;
const d = project.data;
const [allEvidence, allFigures, allMaterials] = await Promise.all([getCollection('evidence'), getCollection('figures'), getCollection('materials')]);
const mainEvidence = ordered(d.mainEvidence, allEvidence);
const deepEvidence = ordered(d.deepEvidence, allEvidence);
const mainFigures = ordered(d.mainFigures, allFigures);
const deepFigures = ordered(d.deepFigures, allFigures);
const materials = ordered(d.materials, allMaterials).filter((item) => item.data.accessStatus !== 'PENDING');
const { Content } = await render(project);
const names: Record<string,string> = { 'em-trace': 'EM-Trace', 'lowalt-md': 'LowAlt-MD', emvision: 'EMvision', 'quadcontrol-lab': 'QuadControl-Lab' };
const related = (await getCollection('projects')).filter((item) => item.id !== project.id);
const roleLabels: Record<string, string> = { FLAGSHIP: '代表性研究', PHYSICS_MECHANISM: '物理机制', ENGINEERING_FOUNDATION: '工程基础', AUTONOMOUS_BRANCH: '自主系统分支' };
const materialTypes: Record<string, string> = { CV: 'CV', RESEARCH_OVERVIEW: '研究概览', GITHUB: 'GitHub', SELECTED_CODE: '精选代码', EVIDENCE_PAGE: '证据摘要', REPORT: '研究报告' };
---
<BaseLayout title={`${d.title.zh} · ${d.subtitle.zh}`} description={d.summary.zh} path={projectUrl(d.slug)}>
  <article class="project-page" data-project={d.slug}>
  <div class="project-hero">
    <div class="shell">
      <nav class="breadcrumb" aria-label="面包屑"><a href={sitePath('/')}>首页</a><span aria-hidden="true">/</span><span>{d.title.zh}</span></nav>
      <div class="project-overview">
        <div class="project-heading">
          <p class="eyebrow">Research Project / {roleLabels[d.role]}</p>
          <h1>{d.title.zh}</h1>
          <p class="project-subtitle">{projectNarratives[d.slug]?.title ?? d.subtitle.zh}</p>
          <ResearchSummary projectId={d.slug} showTitle={false} />
          <p class="lead">{d.summary.zh}</p>
        </div>
        <div class="project-meta">
          <div><span>研究方向</span><strong>{d.researchTrack.zh}</strong></div>
          <div><span>证据状态</span><strong>{d.status.zh}</strong></div>
        </div>
      </div>
    </div>
  </div>

  {project.id === 'emvision' && <section class="project-highlight" aria-labelledby="highlight-heading"><div class="shell"><h2 id="highlight-heading">研究速览</h2><dl class="highlight-grid"><div><dt>研究问题</dt><dd>固定合成测试域中，训练端 C/G/P 匹配如何影响识别与协议内归因？</dd></div><div><dt>方法</dt><dd>C/G/P 三因素全因子配对实验，使用 20 个配对随机种子。</dd></div><div><dt>主要结果</dt><dd>当前冻结协议内的合成识别端点对比，且存在条件依赖与交互。</dd></div><div><dt>边界</dt><dd>结论限于固定合成测试域，不代表实测雷达或跨域性能。</dd></div></dl></div></section>}

  <section class="section project-section" aria-labelledby="question-heading"><div class="shell project-two-column"><div class="project-side"><p class="eyebrow">01 / Question</p><h2 id="question-heading">研究问题</h2></div><div><p class="large-question">{d.researchQuestion.zh}</p><p>{d.whyItMatters.zh}</p></div></div></section>

  <section class="section project-section method-section" aria-labelledby="method-heading"><div class="shell project-two-column"><div class="project-side"><p class="eyebrow">02 / Method</p><h2 id="method-heading">方法与协议</h2></div><div><ol class="method-list">{d.methods.map((method, index) => <li><span>{String(index+1).padStart(2, '0')}</span><p>{method.zh}</p></li>)}</ol></div></div></section>

  <section class="section project-section" id="evidence" aria-labelledby="evidence-heading"><div class="shell"><div class="section-intro"><p class="eyebrow">03 / Evidence</p><h2 id="evidence-heading">代表结果与解释边界</h2><p>每项证据同时列出结果、实验协议、来源与解释边界。负结果、更正与撤回记录一并保留。</p></div><div class="evidence-grid">{mainEvidence.map((item) => <EvidenceBlock evidence={item} />)}</div>
    {deepEvidence.length > 0 && <details class="deep-evidence"><summary>展开审计细节与补充证据 <span aria-hidden="true">＋</span></summary><div class="evidence-grid">{deepEvidence.map((item) => <EvidenceBlock evidence={item} />)}</div></details>}
  </div></section>

  <section class="section project-section figure-section" id="figures" aria-labelledby="figures-heading"><div class="shell"><div class="section-intro"><p class="eyebrow">04 / Figures</p><h2 id="figures-heading">代表图件</h2><p>图件保留原始来源与核验信息。点击可放大、平移，也可打开完整原图。</p></div><div class:list={['figures-grid', {'figure-primary': d.slug === 'emvision'}]}>{mainFigures.map((figure) => <FigureFrame figure={figure} />)}</div>{deepFigures.length > 0 && <details class="deep-figures"><summary>查看更多研究图件（{deepFigures.length}）</summary><div class:list={['figures-grid', {'figure-primary': d.slug === 'emvision'}]}>{deepFigures.map((figure) => <FigureFrame figure={figure} />)}</div></details>}</div></section>

  <section class="section project-section learning-section" aria-labelledby="learning-heading"><div class="shell project-two-column"><div class="project-side"><p class="eyebrow">05 / Interpretation</p><h2 id="learning-heading">研究收获与限制</h2></div><div class="prose"><Content /><h3>明确的限制</h3><ul>{d.limitations.map((limit) => <li>{limit.zh}</li>)}</ul><div class="contribution-note"><h3>个人贡献</h3>{d.contributions.map((item) => <p>{item.zh}</p>)}</div></div></div></section>

  <section class="section project-section project-materials" id="materials" aria-labelledby="project-materials-heading"><div class="shell"><div class="section-intro"><p class="eyebrow">06 / Sources</p><h2 id="project-materials-heading">公开资料</h2></div><div class="source-list">{materials.map((material) => <a href={sitePath(material.data.publicUrl)} target="_blank" rel="noopener noreferrer"><span>{materialTypes[material.data.type]}</span><strong>{material.data.label.zh}</strong><span aria-hidden="true">↗</span></a>)}</div></div></section>

  <section class="section related-section" aria-labelledby="related-heading"><div class="shell"><p class="eyebrow">Next / Explore</p><h2 id="related-heading">继续浏览研究</h2><div class="related-links">{related.map((item) => <a href={projectUrl(item.data.slug)}>{names[item.data.slug]} <span aria-hidden="true">↗</span></a>)}</div></div></section>
  <nav class="project-return" aria-label="返回导航">
  <a href={sitePath('/')} class="floating-back" aria-label="返回上一页" onclick="if(document.referrer.includes(window.location.host)) { window.history.back(); return false; }">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M19 12H5M12 19l-7-7 7-7"/>
    </svg>
    <span>返回</span>
  </a>
  </nav>
  </article>
</BaseLayout>
