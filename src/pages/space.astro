---
import { getImage } from 'astro:assets';
import { sitePath } from '../lib/urls';
import PersonalSpaceOpening from '../components/PersonalSpaceOpening.astro';
import '../styles/personal-space.css';

const photoImports = import.meta.glob<{ default: import('astro').ImageMetadata }>('../assets/personal/photo-*.jpg', { eager: true });
const descriptions = ['蓝天下的花枝', '物理实验竞赛获奖证书', '写着跑步文字的鞋子', '运动奖牌与证书', '开发板与电脑上的程序', '运动及活动证书拼图', '编程语言对比图', '书法作品', '赵斐然手写签名', '机动车驾驶证封面', '羽毛球比赛荣誉证书', '跑步记录截图', '云雾中的山峰与松树', '金黄色树木与道路', '山前的飞机展品', '叠放的书籍', '室内的飞机模型展品', '身穿校服的人像'];
const captions = [
  "花开有时，抬头恰好。",
  "格物穷理，从一次实验开始。",
  "我跑，故我在。",
  "奖牌会褪色，热爱不会。",
  "让几行代码，在真实世界里亮起来。",
  "把热爱，留成一页页青春。",
  "语言各异，创造相通。",
  "心随笔走，墨自成章。",
  "一笔一画，写下自己的名字。",
  "握住方向盘，也握住新的方向。",
  "一拍一球，都是热爱的回声。",
  "一步一步，把日常跑成远方。",
  "松间有雾，山外有天。",
  "秋天把路，铺成了金色。",
  "山在身后，天空在前。",
  "翻开书页，世界又大了一点。",
  "还未起飞，想象已抵达天空。",
  "少年意气，藏在安静的片刻里。"
];
const colors = ['coral', 'blue', 'lemon', 'pink'];
const slots = await Promise.all(Object.entries(photoImports).sort(([a], [b]) => a.localeCompare(b)).map(async ([, asset], index) => ({
  title: `照片 ${String(index + 1).padStart(2, '0')}`,
  alt: descriptions[index], caption: captions[index], color: colors[index % colors.length],
  rotation: index === 1 ? -90 : index === 3 ? 90 : 0,
  width: asset.default.width, height: asset.default.height,
  thumbnail: await getImage({ src: asset.default, width: Math.min(640, asset.default.width), format: 'webp' }),
  full: await getImage({ src: asset.default, width: Math.min(1920, asset.default.width), format: 'webp' }),
})));
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="description" content="赵斐然的个人空间，自由作品与生活记录的独立画廊。" />
    <link rel="icon" href={sitePath('/favicon.svg')} type="image/svg+xml" />
    <title>个人空间 · 赵斐然</title>
    <script is:inline>
      (() => {
        let seen = false;
        try { seen = sessionStorage.getItem('zfr-personal-opening-session-v1') === 'seen'; } catch {}
        if (seen || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        document.documentElement.classList.add('space-opening-pending');
        // Return to the readable gallery if the module fails to load.
        window.spaceOpeningWatchdog = window.setTimeout(() => {
          document.documentElement.classList.remove('space-opening-pending');
          document.dispatchEvent(new Event('space:opening-change'));
        }, 4500);
      })();
    </script>
  </head>
  <body>
    <a class="space-skip" href="#space-main">跳到个人空间</a>
    <header class="space-nav">
      <a class="space-back" href={`${sitePath('/')}#about`} aria-label="返回科研主页">
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M19 12H5M12 19l-7-7 7-7" /></svg>
        <span>返回</span>
      </a>
      <span class="space-owner">赵斐然</span>
    </header>
    <main id="space-main">
      <div class="space-intro">
        <h1>个人空间<span aria-hidden="true">.</span></h1>
        <p>自由作品，生活片段。</p>
      </div>
      <section class="space-stage" aria-label="作品与生活记录画廊" aria-describedby="space-help">
        <ol class="space-cards">
          {slots.map((slot, index) => (
            <li class="space-card" data-color={slot.color} data-slot={index} data-photo-src={slot.full.src} data-photo-alt={slot.alt} data-photo-caption={slot.caption} data-photo-thumbnail={slot.thumbnail.src} data-photo-width={slot.width} data-photo-height={slot.height} data-photo-rotation={slot.rotation}>
              <button type="button" class="space-card-button" data-open-card aria-haspopup="dialog" aria-label={`${slot.title}，${slot.alt}，点击查看大图`}>
                {slot.rotation ? <svg class="card-photo" role="img" aria-label={slot.alt} viewBox={`0 0 ${slot.height} ${slot.width}`} preserveAspectRatio="xMidYMid slice"><image href={slot.thumbnail.src} width={slot.width} height={slot.height} transform={slot.rotation < 0 ? `translate(0 ${slot.width}) rotate(-90)` : `translate(${slot.height} 0) rotate(90)`} /></svg> : <img class="card-photo" src={slot.thumbnail.src} width={slot.thumbnail.attributes.width} height={slot.thumbnail.attributes.height} alt={slot.alt} loading={index < 3 ? "eager" : "lazy"} decoding="async" draggable="false" />}
                <span class="card-copy"><span class="card-title-line"><strong>{slot.title}</strong><span class="card-photo-hint">点击查看大图</span></span><span class="card-photo-caption">{slot.caption}</span></span>
              </button>
            </li>
          ))}
        </ol>
      </section>
      <footer class="space-controls">
        <p id="space-help">按住拖动，松开滑行。点击卡片展开。</p>
        <div class="space-buttons">
          <button type="button" class="space-replay" data-opening-replay>重播开场</button>
          <button type="button" data-space-step="-1" aria-label="向右浏览卡片"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m14 5-7 7 7 7" /></svg></button>
          <button type="button" data-space-pause aria-pressed="false">暂停漂浮</button>
          <button type="button" data-space-step="1" aria-label="向左浏览卡片"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m10 5 7 7-7 7" /></svg></button>
        </div>
      </footer>
      <noscript><div class="space-noscript"><p>直接打开照片：</p>{slots.map((slot) => <a href={slot.full.src}>{slot.title} </a>)}</div></noscript>
    </main>
    <dialog class="space-dialog" aria-labelledby="space-dialog-title" aria-describedby="space-photo-caption">
      <button type="button" class="dialog-close" data-space-close aria-label="关闭卡片"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" /></svg></button>
      <div class="dialog-photo-stage"><img class="dialog-photo" data-space-photo alt="" /></div>
      <div class="dialog-photo-footer"><div class="dialog-photo-description"><h2 id="space-dialog-title">照片</h2><p id="space-photo-caption" data-space-caption></p></div><div class="dialog-photo-actions"><button type="button" data-photo-rotate aria-label="顺时针旋转照片">旋转</button><button type="button" data-photo-step="-1" aria-label="上一张照片">上一张</button><button type="button" data-photo-step="1" aria-label="下一张照片">下一张</button></div></div>
    </dialog>
    <PersonalSpaceOpening />
    <script>
      import { setupPersonalSpace } from '../lib/personal-space';
      import { setupPersonalSpaceOpening } from '../lib/personal-space-opening';
      setupPersonalSpace();
      setupPersonalSpaceOpening();
    </script>
  </body>
</html>
