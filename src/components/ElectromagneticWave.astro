---
// Normalized ideal plane wave: E along +y, B along +z, E × B along +x.
// Field relationships: OpenStax, University Physics Vol. 2, §16.2.
// Independently drawn illustration; no project measurements are represented.
const project = (x: number, y: number, z: number) => [70 + x - .65 * z, 128 - .08 * x - y + .35 * z];
const amplitude = 46;
const period = 140;
const vectorCount = 25;
const wave = (x: number) => amplitude * Math.sin(2 * Math.PI * x / period);
const coordinate = (point: number[]) => point.map((value) => value.toFixed(2)).join(' ');
// One extra period on each side allows a seamless transform within fixed planes.
const samples = Array.from({ length: 321 }, (_, index) => -140 + 560 * index / 320);
const electric = samples.map((x) => project(x, wave(x), 0));
const magnetic = samples.map((x) => project(x, 0, wave(x)));
const path = (points: number[][]) => points.map((point, index) => `${index ? 'L' : 'M'} ${coordinate(point)}`).join(' ');
const electricPath = path(electric);
const magneticPath = path(magnetic);
const fieldVectors = Array.from({ length: vectorCount }, (_, index) => 280 * index / (vectorCount - 1))
  .filter((x) => Math.abs(wave(x)) > 1)
  .map((x) => ({ origin: project(x, 0, 0), e: project(x, wave(x), 0), b: project(x, 0, wave(x)) }));
const vectorPath = (field: 'e' | 'b') => fieldVectors.map((vector) => `M ${coordinate(vector.origin)} L ${coordinate(vector[field])}`).join(' ');
const electricClip = [[0, 58, 0], [280, 58, 0], [280, -58, 0], [0, -58, 0]]
  .map(([x, y, z]) => coordinate(project(x, y, z))).join(' ');
const magneticClip = [[0, 0, 58], [280, 0, 58], [280, 0, -58], [0, 0, -58]]
  .map(([x, y, z]) => coordinate(project(x, y, z))).join(' ');
const planePath = (curve: string) => `${curve} L ${coordinate(project(420, 0, 0))} L ${coordinate(project(-140, 0, 0))} Z`;
---

<figure class="em-wave-figure">
  <button class="em-wave-control" type="button" aria-label="播放电磁波传播动画" aria-pressed="false" data-wave-amplitude={amplitude} data-wave-period={period} data-wave-vector-count={vectorCount}>
  <svg class="em-wave-diagram" viewBox="0 0 430 205" role="img" aria-labelledby="approach-wave-title approach-wave-description">
    <title id="approach-wave-title">三维坐标中的电磁波传播示意</title>
    <desc id="approach-wave-description">理想平面电磁波：电场 E 沿 y 方向、磁场 B 沿 z 方向同相振荡，沿正 x 方向传播。两种场的显示振幅分别归一化，仅作概念示意。</desc>
    <defs>
      <clipPath id="approach-wave-electric-clip"><polygon points={electricClip} /></clipPath>
      <clipPath id="approach-wave-magnetic-clip"><polygon points={magneticClip} /></clipPath>
      <marker id="approach-wave-axis" viewBox="0 0 6 6" refX="5" refY="3" markerWidth="5" markerHeight="5" orient="auto">
        <path d="M 0 0 L 6 3 L 0 6" fill="none" stroke="var(--ink-soft)" stroke-width="1" />
      </marker>
      <marker id="approach-wave-electric" viewBox="0 0 5 5" refX="4" refY="2.5" markerWidth="4" markerHeight="4" orient="auto">
        <path d="M 0 0 L 5 2.5 L 0 5 Z" fill="var(--blue)" />
      </marker>
      <marker id="approach-wave-magnetic" viewBox="0 0 5 5" refX="4" refY="2.5" markerWidth="4" markerHeight="4" orient="auto">
        <path d="M 0 0 L 5 2.5 L 0 5 Z" fill="#8a6a51" />
      </marker>
    </defs>
    <g class="wave-axes" fill="none" marker-end="url(#approach-wave-axis)">
      <path d="M 45 130 L 397 101.84" />
      <path d="M 70 161 L 70 43" />
      <path d="M 103 110.23 L 16 157.08" />
    </g>
    <g class="wave-magnetic" clip-path="url(#approach-wave-magnetic-clip)">
      <g class="wave-pattern">
      <path class="wave-plane" d={planePath(magneticPath)} />
      <path class="wave-curve" d={magneticPath} />
      </g>
      <path class="wave-vectors" data-wave-field="b" marker-end="url(#approach-wave-magnetic)" d={vectorPath('b')} />
    </g>
    <g class="wave-electric" clip-path="url(#approach-wave-electric-clip)">
      <g class="wave-pattern">
      <path class="wave-plane" d={planePath(electricPath)} />
      <path class="wave-curve" d={electricPath} />
      </g>
      <path class="wave-vectors" data-wave-field="e" marker-end="url(#approach-wave-electric)" d={vectorPath('e')} />
    </g>
    <g class="wave-axis-labels">
      <text x="405" y="108">x</text>
      <text x="66" y="33">y</text>
      <text x="8" y="174">z</text>
      <text x="324" y="90">k</text>
    </g>
    <text class="wave-field-label wave-electric" x="120" y="72">E</text>
    <text class="wave-field-label wave-magnetic" x="229" y="150">B</text>
  </svg>
  </button>
</figure>

<style>
  .em-wave-figure { width: 100%; margin: 0; }
  .em-wave-control {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  .em-wave-control:focus-visible { outline: 1px solid var(--blue); outline-offset: 4px; }
  .em-wave-control[aria-disabled="true"] { cursor: default; }
  .em-wave-diagram { display: block; width: 100%; height: auto; overflow: visible; }
  .wave-axes { stroke: var(--ink-soft); stroke-width: .85; opacity: .55; }
  .wave-electric { color: var(--blue); }
  .wave-magnetic { color: #8a6a51; }
  .wave-plane { fill: currentColor; opacity: .055; }
  .wave-vectors { fill: none; stroke: currentColor; stroke-width: .65; opacity: .24; }
  .wave-curve { fill: none; stroke: currentColor; stroke-width: 1.5; opacity: .8; transition: opacity .25s ease; }
  .wave-axis-labels { fill: var(--ink-soft); font: italic 15px 'Cambria Math', var(--serif); }
  .wave-field-label { fill: currentColor; font: italic 19px 'Cambria Math', var(--serif); }
  @media (hover: hover) and (pointer: fine) {
    .em-wave-figure:hover .wave-curve { opacity: 1; }
  }
  .em-wave-control[aria-pressed="true"] .wave-curve { opacity: 1; }
  @media (prefers-reduced-motion: reduce) {
    .wave-curve { transition: none; }
  }
</style>

<script>
  import { setupWaveInteraction } from '../lib/wave-interaction';
  document.querySelectorAll<HTMLButtonElement>('.em-wave-control').forEach(setupWaveInteraction);
</script>
