---
import { projectUrl } from '../lib/content';
import { sitePath } from '../lib/urls';
import { getCollection } from 'astro:content';

interface Props {
  profile: {
    publicName: { zh: string; en?: string };
    schoolWording: { zh: string };
    githubUrl: string;
    cvMaterialId?: string;
  };
}

const { profile } = Astro.props;
const cv = (await getCollection('materials')).find((item) => item.id === profile.cvMaterialId)?.data;
const cvUrl = cv?.accessStatus === 'PUBLIC' && cv.publicUrl ? sitePath(cv.publicUrl) : undefined;

// Abstract wavefront artwork, not simulation data. Generated as static SVG.
const waveContours = Array.from({ length: 17 }, (_, i) => (
  `M ${470 + i * 14} -45 C ${110 + i * 10} 100 ${95 + i * 12} 270 ${345 + i * 11} 370 S ${680 + i * 8} 575 ${255 + i * 16} 745`
));
const crossingContours = Array.from({ length: 9 }, (_, i) => (
  `M -40 ${410 + i * 17} C 195 ${575 + i * 8} 370 ${185 + i * 14} 565 ${285 + i * 17} S 775 ${555 + i * 15} 880 ${380 + i * 22}`
));
---

<section class="hero-section" aria-labelledby="hero-title">
  <img class="hero-signature" src="/hero-signature.png" alt="赵斐然手写签名" width="1774" height="887" decoding="async" />
  <!-- Precision Electromagnetic Field Background (Dynamic effects on the right) -->
  <div class="hero-em-field" aria-hidden="true">
    <svg class="em-svg" viewBox="0 0 1400 700" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <!-- Fine Cartesian Coordinate Grid -->
        <pattern id="em-coord-grid" width="50" height="50" patternUnits="userSpaceOnUse">
          <circle cx="25" cy="25" r="0.8" fill="var(--ink-faint)" opacity="0.2" />
          <path d="M 25 21 L 25 29 M 21 25 L 29 25" stroke="var(--ink-faint)" stroke-width="0.5" opacity="0.15" />
        </pattern>
      </defs>

      <!-- 1. Coordinate Grid Canvas (Subtle overall base) -->
      <rect width="100%" height="100%" fill="url(#em-coord-grid)" />

      <!-- RIGHT SIDE DYNAMIC EFFECTS (Emanating from a theoretical sensor on the right) -->
      <g class="right-side-dynamics">
        
        <!-- 2. Concentric Wavefronts & Equipotential Contours (Origin at 1100, 350) -->
        <g class="wavefront-group">
          <circle cx="1100" cy="350" r="120" fill="none" stroke="var(--blue)" stroke-width="1" opacity="0.1" />
          <circle cx="1100" cy="350" r="220" fill="none" stroke="var(--blue)" stroke-width="1.2" stroke-dasharray="6 6" opacity="0.12" />
          <circle cx="1100" cy="350" r="350" fill="none" stroke="var(--blue)" stroke-width="1" opacity="0.08" />
          <circle cx="1100" cy="350" r="500" fill="none" stroke="var(--blue)" stroke-width="1.5" stroke-dasharray="3 9" opacity="0.08" />
          <circle cx="1100" cy="350" r="700" fill="none" stroke="var(--blue)" stroke-width="1" opacity="0.06" />
          <circle cx="1100" cy="350" r="950" fill="none" stroke="var(--blue)" stroke-width="2" stroke-dasharray="12 12" opacity="0.04" />
        </g>

        <!-- 3. Ray-Tracing & Directional Propagation Vectors -->
        <g class="propagation-rays" opacity="0.18">
          <!-- Horizontal baseline -->
          <line x1="600" y1="350" x2="1400" y2="350" stroke="var(--blue)" stroke-width="1" stroke-dasharray="2 4" />
          <!-- Ray scanning angles -->
          <line x1="800" y1="50" x2="1400" y2="650" stroke="var(--blue)" stroke-width="0.8" stroke-dasharray="4 4" />
          <line x1="1400" y1="50" x2="800" y2="650" stroke="var(--blue)" stroke-width="0.8" stroke-dasharray="4 4" />
        </g>

      </g>
    </svg>
    <svg class="field-wave-svg" viewBox="0 0 800 700" fill="none" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <linearGradient id="hero-wave-ink" x1="140" y1="50" x2="650" y2="640" gradientUnits="userSpaceOnUse">
          <stop stop-color="var(--blue)" stop-opacity="0.03" />
          <stop offset="0.38" stop-color="var(--blue)" stop-opacity="0.24" />
          <stop offset="0.7" stop-color="var(--blue)" stop-opacity="0.17" />
          <stop offset="1" stop-color="var(--blue)" stop-opacity="0.02" />
        </linearGradient>
        <radialGradient id="hero-wave-fade">
          <stop offset="0.2" stop-color="white" />
          <stop offset="0.7" stop-color="white" stop-opacity="0.7" />
          <stop offset="1" stop-color="white" stop-opacity="0" />
        </radialGradient>
        <mask id="hero-wave-mask">
          <ellipse cx="440" cy="375" rx="410" ry="355" fill="url(#hero-wave-fade)" />
        </mask>
      </defs>
      <g mask="url(#hero-wave-mask)">
        <g class="field-wave-far" stroke="var(--blue)" stroke-opacity="0.08" stroke-width="0.8">
          {crossingContours.map((d) => <path d={d} vector-effect="non-scaling-stroke" />)}
        </g>
        <g class="field-wave-near" stroke="url(#hero-wave-ink)" stroke-width="1">
          {waveContours.map((d, i) => <path d={d} stroke-width={i === 8 ? 1.6 : 0.85} vector-effect="non-scaling-stroke" />)}
        </g>
      </g>
    </svg>
  </div>

  <!-- Content Container (Asymmetric: Content left, Effects right) -->
  <div class="shell">
    <div class="hero-layout">
      <div class="hero-content">
        
        <!-- Identity Lockup: Simple Portrait + Titles -->
        <div class="hero-header-row">
          <!-- Simple Portrait (Integrated near text, hover effect preserved) -->
          <div class="simple-portrait-wrapper">
            <img
              src="/hero-portrait.jpg"
              alt={`${profile.publicName.zh}头像`}
              class="simple-portrait"
              loading="eager"
            />
            <div class="portrait-overlay-tag">
              <span class="tag-ping"></span>
              <span class="tag-label">OBS</span>
            </div>
          </div>

          <div class="hero-titles">
            <div class="hero-badge">
              <span class="badge-dot"></span>
              <span class="badge-text">RESEARCH PORTFOLIO // 2026</span>
            </div>
            <h1 id="hero-title">{profile.publicName.zh}</h1>
            <p class="hero-identity">{profile.schoolWording.zh}本科生</p>
          </div>
        </div>

        <!-- Hero Copy -->
        <p class="hero-deck">
          以物理建模为基础，<br />探索电磁感知、智能探测与自主系统。
        </p>

        <p class="hero-note">从第一性原理物理模型，到可审计复核的科研证据。</p>

        <div class="cta-row">
          <a class="button primary" href="#research-map">
            探索研究脉络 <span class="btn-arrow" aria-hidden="true">↓</span>
          </a>
          <!-- Added CV Button -->
          {cvUrl && (<a class="button subtle" href={cvUrl} target="_blank" rel="noopener noreferrer">
            学术简历 (CV) <span class="btn-arrow" aria-hidden="true">↗</span>
          </a>)}
          <a class="button subtle" href={projectUrl('emvision')}>
            阅读旗舰研究 EMvision <span class="btn-arrow" aria-hidden="true">↗</span>
          </a>
        </div>

        <div class="hero-links">
          <a class="hero-coursework" href={sitePath('/coursework/')}>
            课程基础 / Coursework <span aria-hidden="true">↗</span>
          </a>
          <a class="hero-github" href={profile.githubUrl} target="_blank" rel="noopener noreferrer">
            <svg class="gh-icon" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
            </svg>
            Research Portfolio / GitHub <span aria-hidden="true">↗</span>
          </a>
        </div>

      </div>

      <!-- Right Column: Welcome Text and Drone -->
      <div class="hero-right">
        <div class="hero-welcome">
          <div class="intro-text-wrapper">
            <span class="intro-char">欢</span>
            <span class="intro-char">迎</span>
            <span class="intro-char">来</span>
            <span class="intro-char">到</span>
            <span class="intro-char">我</span>
            <span class="intro-char">的</span>
            <span class="intro-char">世</span>
            <span class="intro-char">界</span>
            <span class="intro-cursor">_</span>
          </div>
          <p class="intro-motto">与其困于方寸，不如自成宇宙</p>
        </div>

        <div class="drone-display" role="img" tabindex="0" aria-label="SolidWorks 四旋翼参数化 CAD 模型，展示机体几何与装配结构">
          <!-- The Drone Image -->
          <img src="/hero-drone.png" alt="SolidWorks Drone Model" class="drone-model" />
          
          <!-- Interactive Effects Elements -->
          <div class="drone-hud-tooltip">
            <span class="hud-label">ASSET_INSPECT //</span>
            <span class="hud-desc">SolidWorks 四旋翼参数化 CAD 模型，展示机体几何与装配结构。</span>
          </div>
          <div class="drone-scan-plane"></div>
          <div class="drone-target-corners">
            <span class="corner tl"></span><span class="corner tr"></span>
            <span class="corner bl"></span><span class="corner br"></span>
          </div>
          <div class="drone-status">
            <span class="status-dot"></span>
            <span>MODEL: SW_DRONE_V1 // LOCK_ACQUIRED</span>
          </div>
        </div>
        
      </div>
    </div>
  </div>
</section>

<style>
  .drone-display:focus-visible { outline: 2px solid var(--blue); outline-offset: 6px; }
  /* =========================================================
     HERO SECTION - ASYMMETRIC LAYOUT
     Left: Text + Simple Photo | Right: Open Dynamic Space
     ========================================================= */

  .hero-section {
    position: relative;
    padding-block: clamp(4.5rem, 8vw, 7.5rem);
    background: var(--paper);
    overflow: hidden;
    border-bottom: 1px solid var(--line-soft);
  }

  /* Flex Layout Wrapper */
  .hero-layout {
    display: flex;
    justify-content: space-between;
    align-items: flex-start; /* Changed from center to push content to top */
    gap: 2rem;
    position: relative;
    z-index: 2;
    min-height: 500px;
  }

  .hero-content {
    max-width: 44rem;
    position: relative;
    z-index: 2;
    padding-right: 2rem;
    padding-top: 1rem;
  }

  .hero-right {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 1.5rem;
    position: relative;
    z-index: 2;
    flex-grow: 1;
    padding-top: 0;
  }

  .hero-signature {
    position: absolute;
    top: 1rem;
    right: max(1rem, calc((100vw - 1200px) / 2));
    width: clamp(230px, 26vw, 380px);
    height: 5.5rem;
    object-fit: cover;
    object-position: center;
    mix-blend-mode: multiply;
    filter: grayscale(1) contrast(2.4);
    opacity: .82;
    pointer-events: none;
    z-index: 3;
  }

  /* --- Welcome Text on the Right --- */
  .hero-welcome {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.5rem;
  }

  .intro-text-wrapper {
    font-family: var(--serif);
    font-size: clamp(2.8rem, 4.5vw, 4rem);
    color: var(--ink);
    font-weight: 600;
    letter-spacing: 0.1em;
    display: flex;
    align-items: center;
  }

  .intro-char {
    display: inline-block;
    /* Opacity controlled by GSAP */
  }

  .intro-cursor {
    display: inline-block;
    margin-left: 0.2rem;
    color: var(--blue);
    font-weight: 400;
  }

  .intro-motto {
    width: 100%;
    margin: .35rem 0 0;
    font-family: var(--serif);
    font-size: clamp(.9rem, 1.25vw, 1.125rem);
    font-weight: 400;
    line-height: 1.8;
    letter-spacing: .18em;
    text-align: center;
    color: var(--ink-soft);
  }

  /* --- Drone Display Area --- */
  .drone-display {
    position: relative;
    margin-top: 1rem;
    width: clamp(280px, 30vw, 450px);
    display: flex;
    justify-content: center;
    align-items: center;
    perspective: 1000px;
    padding: 2rem;
  }

  .drone-model {
    width: 100%;
    height: auto;
    display: block;
    filter: drop-shadow(0 20px 30px rgba(0,0,0,0.1)) contrast(1.1);
    transform: translateZ(20px);
    transition: transform 0.2s ease-out;
    animation: hover-drone 6s ease-in-out infinite;
    cursor: crosshair;
  }

  .drone-hud-tooltip {
    position: absolute;
    top: -3.5rem;
    left: -8rem;
    transform: translateY(10px) scale(0.95);
    background: rgba(18, 35, 50, 0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(99, 179, 237, 0.3);
    border-left: 3px solid #63b3ed; /* Sci-fi accent line */
    padding: 0.8rem 1rem;
    border-radius: 4px;
    width: 280px;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    color: rgba(255, 255, 255, 0.9);
    box-shadow: 0 10px 25px rgba(0,0,0,0.2), inset 0 0 0 1px rgba(255,255,255,0.05);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease, transform 0.3s ease;
    z-index: 10;
  }

  .drone-display:hover .drone-hud-tooltip {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  .hud-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.65rem;
    color: #63b3ed;
    font-weight: 600;
    letter-spacing: 0.1em;
  }

  .hud-desc {
    font-size: 0.75rem;
    line-height: 1.5;
    letter-spacing: 0.03em;
  }

  .drone-scan-plane {
    position: absolute;
    inset: 10%;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(99, 179, 237, 0.15) 0%, transparent 70%);
    transform: rotateX(75deg);
    animation: pulse-plane 4s infinite alternate;
    pointer-events: none;
    z-index: -1;
  }

  .drone-target-corners {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .corner {
    position: absolute;
    width: 15px;
    height: 15px;
    border: 2px solid var(--blue);
    opacity: 0.4;
  }
  .corner.tl { top: 0; left: 0; border-right: none; border-bottom: none; }
  .corner.tr { top: 0; right: 0; border-left: none; border-bottom: none; }
  .corner.bl { bottom: 0; left: 0; border-right: none; border-top: none; }
  .corner.br { bottom: 0; right: 0; border-left: none; border-top: none; }

  .drone-status {
    position: absolute;
    bottom: -1rem;
    right: 0;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.65rem;
    color: var(--ink-soft);
    letter-spacing: 0.1em;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    background: rgba(255,255,255,0.5);
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    backdrop-filter: blur(4px);
  }

  .status-dot {
    width: 6px;
    height: 6px;
    background: #48bb78;
    border-radius: 50%;
    animation: blink-fast 1s infinite steps(2);
  }

  @keyframes hover-drone {
    0%, 100% { transform: translateY(0) translateZ(20px) rotateY(-5deg); }
    50% { transform: translateY(-15px) translateZ(20px) rotateY(5deg); }
  }

  @keyframes pulse-plane {
    0% { transform: rotateX(75deg) scale(0.9); opacity: 0.5; }
    100% { transform: rotateX(75deg) scale(1.1); opacity: 1; }
  }

  @keyframes blink-fast {
    50% { opacity: 0; }
  }

  .hero-em-field {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .em-svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .field-wave-svg {
    position: absolute;
    right: -3%;
    top: 0;
    width: 60%;
    height: 100%;
    overflow: hidden;
  }

  @media (min-width: 901px) and (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .field-wave-near, .field-wave-far { will-change: transform; }
  }

  /* --- Layout (Content Left, Effects Right) --- */
  .shell {
    position: relative;
    z-index: 1;
    display: flex;
  }

  .hero-content {
    /* Takes up the left side, leaving right side for SVG */
    max-width: 44rem;
    padding-right: 2rem;
  }

  /* --- Left Column: Identity Row (Photo + Title) --- */
  .hero-header-row {
    display: flex;
    align-items: center;
    gap: clamp(1.25rem, 3vw, 2rem);
    margin-bottom: 1.75rem;
  }

  /* Simple Photo Integration */
  .simple-portrait-wrapper {
    position: relative;
    width: clamp(110px, 14vw, 135px);
    aspect-ratio: 3 / 4;
    border-radius: 6px;
    overflow: hidden;
    background: var(--line-soft);
    box-shadow: 0 8px 24px -6px rgba(33, 79, 115, 0.15), 0 2px 6px rgba(0,0,0,0.04);
    flex-shrink: 0;
    /* Subtle border instead of complex frame */
    border: 1px solid rgba(255, 255, 255, 0.5);
  }

  .simple-portrait {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .simple-portrait-wrapper:hover .simple-portrait {
    transform: scale(1.06);
  }

  .portrait-overlay-tag {
    position: absolute;
    bottom: 0.4rem;
    right: 0.4rem;
    background: rgba(33, 79, 115, 0.85);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    color: var(--white);
    padding: 0.2rem 0.4rem;
    border-radius: 3px;
    font: 700 0.55rem/1 var(--sans);
    letter-spacing: 0.1em;
    display: flex;
    align-items: center;
    gap: 0.25rem;
    opacity: 0;
    transform: translateY(4px);
    transition: all 0.3s ease;
  }

  .simple-portrait-wrapper:hover .portrait-overlay-tag {
    opacity: 1;
    transform: translateY(0);
  }

  .tag-ping {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: #63b3ed;
  }



  /* Titles */
  .hero-titles {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.25rem 0.65rem;
    background: rgba(33, 79, 115, 0.06);
    border: 1px solid rgba(33, 79, 115, 0.12);
    border-radius: 3px;
    margin-bottom: 1rem;
    align-self: flex-start;
  }

  .badge-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--blue);
  }

  .badge-text {
    font: 700 0.65rem/1.2 var(--sans);
    letter-spacing: 0.1em;
    color: var(--blue);
  }

  .hero-titles h1 {
    font-family: var(--serif);
    font-size: clamp(2.5rem, 4vw, 3.5rem);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.025em;
    color: var(--blue);
    margin: 0;
  }

  .hero-identity {
    margin-top: 0.75rem;
    font-family: var(--sans);
    font-size: 1.05rem;
    font-weight: 500;
    color: var(--ink-soft);
    letter-spacing: 0.02em;
  }

  /* Copy beneath */
  .hero-deck {
    font-family: var(--serif);
    font-size: clamp(1.25rem, 1.8vw, 1.55rem);
    color: var(--ink);
    line-height: 1.6;
    margin-top: 1rem;
  }

  .hero-note {
    font-size: 0.98rem;
    color: var(--ink-soft);
    line-height: 1.6;
    margin-top: 0.85rem;
  }

  .cta-row {
    margin-top: 2.25rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
  }

  .btn-arrow {
    display: inline-block;
    transition: transform 0.15s ease;
  }

  .button:hover .btn-arrow {
    transform: translate(2px, -2px);
  }

  .hero-links {
    margin-top: 1.25rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.85rem;
  }

  .hero-github,
  .hero-coursework {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--ink-soft);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .hero-github:hover,
  .hero-coursework:hover {
    color: var(--blue);
  }

  .gh-icon {
    color: var(--ink-faint);
  }

  /* =========================================================
     RESPONSIVE BREAKPOINTS
     ========================================================= */
  @media (max-width: 992px) {
    .hero-header-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.25rem;
    }
    
    .simple-portrait-wrapper {
      width: 100px;
    }

    .hero-content {
      padding-right: 0;
    }

    .hero-telemetry {
      display: none;
    }
  }

  @media (max-width: 900px) {
    .field-wave-svg { top: auto; bottom: 0; right: -28%; width: 135%; height: 52%; opacity: .55; }
    .hero-section { padding-block: clamp(3rem, 7vw, 4.5rem); }
    .hero-layout { flex-direction: column; align-items: stretch; min-height: 0; }
    .hero-content { width: 100%; max-width: none; min-width: 0; }
    .hero-right { width: 100%; flex-grow: 0; align-items: center; }
    .hero-signature { top: 1.25rem; right: 1rem; width: min(50vw, 220px); height: 4.5rem; }
    .hero-welcome { align-items: center; max-width: 100%; }
    .intro-text-wrapper { font-size: clamp(1.4rem, 5vw, 2.5rem); letter-spacing: .06em; }
    .intro-motto { font-size: .8125rem; letter-spacing: .08em; }
    .drone-display { width: min(100%, 280px); margin-top: 0; padding: 1rem; }
  }

  @media (max-width: 700px) {
    .cta-row { flex-direction: column; align-items: stretch; gap: .75rem; }
    .cta-row .button { width: 100%; }
  }
</style>

<script>
  import gsap from 'gsap';

  const initIntro = () => {
    const hasSeenIntro = sessionStorage.getItem('hasSeenHeroIntro');
    // A played intro always ends at the Hero, including bookmarked section URLs.
    // Once the intro has been seen, section links keep their normal behavior.
    const navigation = performance.getEntriesByType('navigation')[0] as PerformanceNavigationTiming | undefined;
    const startAtHero = !hasSeenIntro || (!window.location.hash && navigation?.type !== 'back_forward');
    if (!hasSeenIntro && window.location.hash) {
      history.replaceState(history.state, '', window.location.pathname + window.location.search);
    }
    const showHeroTop = () => {
      if (startAtHero) window.scrollTo({ top: 0, left: 0, behavior: 'instant' });
    };
    if (startAtHero) {
      const previousScrollRestoration = history.scrollRestoration;
      history.scrollRestoration = 'manual';
      window.addEventListener('pagehide', () => {
        history.scrollRestoration = previousScrollRestoration;
      }, { once: true });
      showHeroTop();
      window.addEventListener('pageshow', (event) => {
        if (!event.persisted) showHeroTop();
      }, { once: true });
    }
    const previousOverflow = document.body.style.overflow;
    
    if (hasSeenIntro || window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      document.documentElement.classList.remove('hero-intro-pending');
      // Skip animation, just set everything to visible
      gsap.set([
        ".simple-portrait-wrapper", 
        ".hero-titles > *", 
        ".hero-deck", 
        ".hero-note", 
        ".cta-row", 
        ".hero-links",
        ".hero-em-field",
        ".hero-signature",
        ".intro-motto",
        ".drone-display",
        ".intro-char"
      ], { opacity: 1 });
      gsap.set(".hero-signature", { opacity: 0.82 });
      
      gsap.set(".intro-cursor", { opacity: 0 });
      gsap.set(".hero-welcome", { clearProps: "all" });
      showHeroTop();
      return;
    }

    sessionStorage.setItem('hasSeenHeroIntro', 'true');

    // 1. Initial State Setup
    // Explicitly hide only the elements we will animate so parent containers don't trap them
    gsap.set([
      ".simple-portrait-wrapper", 
      ".hero-titles > *", 
      ".hero-deck", 
      ".hero-note", 
      ".cta-row", 
      ".hero-links",
      ".hero-em-field",
      ".hero-signature",
      ".intro-motto",
      ".drone-display"
    ], { opacity: 0 });
    
    // Position the welcome text in the center of the screen initially
    gsap.set(".hero-welcome", { 
      position: "fixed", 
      top: "40%", 
      left: "50%", 
      xPercent: -50, 
      yPercent: -50,
      scale: 1.5,
      zIndex: 999
    });
    gsap.set([".intro-char", ".intro-cursor"], { opacity: 0 });
    document.documentElement.classList.remove('hero-intro-pending');

    const tl = gsap.timeline({
      onComplete: () => {
        document.body.style.overflow = previousOverflow;
        showHeroTop();
        requestAnimationFrame(showHeroTop);
      }
    });

    // Lock scroll during intro
    document.body.style.overflow = 'hidden';

    // 2. Typewriter effect for "欢迎来到我的世界" (Faster)
    tl.fromTo(".intro-char", 
      { opacity: 0, filter: "blur(4px)", x: -10 }, 
      { opacity: 1, filter: "blur(0px)", x: 0, duration: 0.15, stagger: 0.05, ease: "power2.out" },
      "+=0.2"
    );
    
    // Flash cursor
    tl.to(".intro-cursor", { opacity: 0, duration: 0.1, repeat: 3, yoyo: true }, "+=0.05");

    // Reveal the motto after the welcome text.
    tl.fromTo(".intro-motto",
      { y: 6 },
      { y: 0, opacity: 1, duration: 0.4, ease: "power2.out" },
      "-=0.1"
    );

    tl.to({}, { duration: 0.4 }); // Hold

    // 3. Move Intro: Move text to right space
    tl.addLabel("moveRight");
    
    tl.add(() => {
      const startRect = document.querySelector(".hero-welcome")!.getBoundingClientRect();
      gsap.set(".hero-welcome", { clearProps: "position,top,left,xPercent,yPercent,scale,zIndex" });
      const endRect = document.querySelector(".hero-welcome")!.getBoundingClientRect();
      
      const deltaX = startRect.left - endRect.left;
      const deltaY = startRect.top - endRect.top;
      
      gsap.fromTo(".hero-welcome", 
        { x: deltaX, y: deltaY, scale: 1.5, transformOrigin: "top left" },
        { x: 0, y: 0, scale: 1, duration: 0.8, ease: "power3.inOut" }
      );
    });

    // 4. Reveal the Hero elements using .to() since they are at opacity 0
    
    // The portrait and title come in from the left
    tl.fromTo(".simple-portrait-wrapper", 
      { x: -30 },
      { x: 0, opacity: 1, duration: 0.8, ease: "power3.out" }, 
      "moveRight+=0.2"
    );
    tl.fromTo(".hero-titles > *", 
      { x: -20 },
      { x: 0, opacity: 1, duration: 0.6, stagger: 0.08, ease: "power3.out" }, 
      "moveRight+=0.3"
    );
    
    // The drone emerges
    tl.fromTo(".drone-display", 
      { y: 30, scale: 0.9 },
      { y: 0, scale: 1, opacity: 1, duration: 1, ease: "back.out(1.5)" }, 
      "moveRight+=0.4"
    );

    tl.fromTo(".hero-signature",
      { y: 8 },
      { y: 0, opacity: 0.82, duration: 0.8, ease: "power2.out" },
      "moveRight+=0.5"
    );
    
    // The SVG waves fade in
    tl.fromTo(".hero-em-field", 
      { scale: 0.95, transformOrigin: "right center" },
      { scale: 1, opacity: 1, duration: 1.2, ease: "power2.out" }, 
      "moveRight+=0.3"
    );
    
    // Text blocks fade up
    tl.fromTo([".hero-deck", ".hero-note", ".cta-row", ".hero-links"], 
      { y: 15 },
      { y: 0, opacity: 1, duration: 0.6, stagger: 0.08, ease: "power3.out" }, 
      "moveRight+=0.4"
    );
  };

  initIntro();

  // Reuse small transform tweens; static SVG remains readable without JS.
  const waveMedia = gsap.matchMedia();
  waveMedia.add('(min-width: 901px) and (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)', () => {
    const hero = document.querySelector<HTMLElement>('.hero-section');
    const near = hero?.querySelector<SVGGElement>('.field-wave-near');
    const far = hero?.querySelector<SVGGElement>('.field-wave-far');
    if (!hero || !near || !far) return;

    gsap.set([near, far], { svgOrigin: '440 375' });
    const nearX = gsap.quickTo(near, 'x', { duration: 1.1, ease: 'power3.out' });
    const nearY = gsap.quickTo(near, 'y', { duration: 1.1, ease: 'power3.out' });
    const nearRotation = gsap.quickTo(near, 'rotation', { duration: 1.3, ease: 'power3.out' });
    const farX = gsap.quickTo(far, 'x', { duration: 1.5, ease: 'power3.out' });
    const farY = gsap.quickTo(far, 'y', { duration: 1.5, ease: 'power3.out' });
    const moveWaves = (event: PointerEvent) => {
      if (event.pointerType !== 'mouse') return;
      const bounds = hero.getBoundingClientRect();
      const x = gsap.utils.clamp(-1, 1, ((event.clientX - bounds.left) / bounds.width - .5) * 2);
      const y = gsap.utils.clamp(-1, 1, ((event.clientY - bounds.top) / bounds.height - .5) * 2);
      nearX(x * 20);
      nearY(y * 14);
      nearRotation(x * 1.4);
      farX(-x * 12);
      farY(-y * 8);
    };
    const resetWaves = () => { nearX(0); nearY(0); nearRotation(0); farX(0); farY(0); };
    hero.addEventListener('pointermove', moveWaves, { passive: true });
    hero.addEventListener('pointerleave', resetWaves);
    window.addEventListener('blur', resetWaves);
    return () => {
      hero.removeEventListener('pointermove', moveWaves);
      hero.removeEventListener('pointerleave', resetWaves);
      window.removeEventListener('blur', resetWaves);
    };
  });
  window.addEventListener('pagehide', (event) => {
    // A cached page keeps its listeners for a working back-button return.
    if (!event.persisted) waveMedia.revert();
  });
  
  // Interactive 3D Drone logic on mouse move
  document.addEventListener('mousemove', (e) => {
    const drone = document.querySelector('.drone-model') as HTMLElement;
    if (!drone) return;
    
    const rect = drone.getBoundingClientRect();
    // Calculate center of drone
    const droneX = rect.left + rect.width / 2;
    const droneY = rect.top + rect.height / 2;
    
    // Calculate normalized distance from center (-1 to 1)
    const mouseX = (e.clientX - droneX) / window.innerWidth;
    const mouseY = (e.clientY - droneY) / window.innerHeight;
    
    // Rotate drone based on mouse position (subtle)
    gsap.to(drone, {
      rotateY: mouseX * 20,
      rotateX: -mouseY * 20,
      duration: 0.5,
      ease: 'power2.out'
    });
  });
</script>
