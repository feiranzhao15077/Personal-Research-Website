---
import { getCollection } from 'astro:content';
import ModelStage from './ModelStage.astro';
import { sitePath } from '../lib/urls';

interface Props { variant?: 'blueprint' | 'personal'; }
const { variant = 'blueprint' } = Astro.props;
const models = (await getCollection('models')).sort((a, b) => a.data.order - b.data.order);
const model = models[0];
---
{model && <a class:list={['model-cabinet-entry', `cabinet-entry-${variant}`]} href={sitePath('/models/')} data-model-entrance data-cabinet-origin={variant === 'personal' ? 'space' : 'research'} data-guide-hint="这些都是我用 Blender 完成的建模哦～点开展柜，还能看看不同视角和小细节！" aria-label={`进入建模展柜，当前展出${model.data.title}`}>
  <div class="cabinet-entry-heading"><h2>建模展柜</h2><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 19 19 5M5 5h14v14" /></svg></div>
  <div class="cabinet-entry-scene" aria-hidden="true">
    <ModelStage title={model.data.title} poster={model.data.spaceCover} model3d={model.data.model3d} mode="entry" />
  </div>
  <div class="cabinet-entry-plaque"><strong>个人建模作品</strong><span class="cabinet-entry-action">进入展柜</span></div>
</a>}
<style>
  .model-cabinet-entry { --cabinet-blue: #214f73; --cabinet-ink: #293944; position: relative; display: block; color: var(--cabinet-ink); text-decoration: none; isolation: isolate; }
  .cabinet-entry-heading { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .cabinet-entry-heading h2 { margin: 0; font: 500 clamp(1.6rem, 2.1vw, 2rem)/1.3 Georgia, 'Noto Serif CJK SC', 'Songti SC', 'SimSun', serif; letter-spacing: -.02em; }
  .cabinet-entry-heading svg { width: 25px; height: 25px; stroke: var(--cabinet-blue); stroke-width: 1.3; transition: transform .3s cubic-bezier(.16, 1, .3, 1); }
  .cabinet-entry-scene { position: relative; overflow: hidden; margin-top: .15rem; }
  .cabinet-entry-plaque { display: flex; align-items: center; justify-content: space-between; gap: .8rem; border-top: 1px solid #ccd5d6; padding-top: .8rem; }
  .cabinet-entry-plaque strong { font-size: clamp(1.15rem, 1.4vw, 1.3rem); line-height: 1.5; font-weight: 600; }
  .cabinet-entry-action { color: var(--cabinet-blue); font-size: .8rem; white-space: nowrap; }
  .model-cabinet-entry:hover { color: var(--cabinet-blue); }
  .model-cabinet-entry:hover .cabinet-entry-heading svg { transform: translate(3px, -3px); }
  .model-cabinet-entry:focus-visible { outline: 3px solid #075fad; outline-offset: 8px; }
  .cabinet-entry-personal { display: grid; grid-template-columns: 1fr 240px; align-items: center; column-gap: 10px; width: min(510px, 100%); min-height: 190px; padding: 0 0 0 24px; border-left: 1px solid #cdc9bd; }
  .cabinet-entry-personal .cabinet-entry-heading { grid-column: 1; grid-row: 1; align-self: end; }
  .cabinet-entry-personal .cabinet-entry-heading h2 { font-size: 1.7rem; }
  .cabinet-entry-personal .cabinet-entry-heading svg { width: 20px; height: 20px; }
  .cabinet-entry-personal .cabinet-entry-scene { grid-column: 2; grid-row: 1 / span 2; width: 100%; margin: 0; }
  .cabinet-entry-personal .cabinet-entry-plaque { grid-column: 1; grid-row: 2; border: 0; padding-top: 8px; align-self: start; }
  .cabinet-entry-personal .cabinet-entry-action { display: none; }
  @media (max-width: 700px) { .cabinet-entry-personal { width: 100%; grid-template-columns: 1fr 185px; min-height: 142px; border-left: 0; border-top: 1px solid #cdc9bd; padding: 6px 0 0; gap: 8px; } .cabinet-entry-personal .cabinet-entry-heading h2 { font-size: 1.45rem; } }
  @media (prefers-reduced-motion: reduce) { .cabinet-entry-heading svg { transition: none; transform: none !important; } }
</style>
<script>
  import { setupCabinetEntrances } from '../lib/model-cabinet';
  setupCabinetEntrances();
</script>
