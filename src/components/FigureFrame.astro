---
import type { Figure } from '../lib/content';
interface Props { figure: Figure; priority?: boolean; }
const { figure, priority = false } = Astro.props;
const f = figure.data;
---
<figure class="figure-frame" id={f.id.toLowerCase()}>
  <a class="figure-image-link" href={f.path} target="_blank" rel="noopener" aria-label={`打开 ${f.title.zh} 原图`}>
    <img src={f.path} width={f.width} height={f.height} alt={f.alt.zh} loading={priority ? 'eager' : 'lazy'} decoding="async" />
    <span class="open-figure">查看完整原图 ↗</span>
  </a>
  <figcaption><span class="figure-id">{f.id}</span> {f.caption.zh}<span class="figure-source">原图来源：{f.sourceProject} · source commit {f.sourceCommit.slice(0, 8)} · SHA-256 已核验</span></figcaption>
</figure>
