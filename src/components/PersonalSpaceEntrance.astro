---
import { sitePath } from '../lib/urls';
---
<a class="personal-space-entry" href={sitePath('/space/')}>
  <span><strong>个人空间</strong><small>自由作品与生活记录</small></span>
  <svg viewBox="0 0 32 32" fill="none" aria-hidden="true"><path d="M6 26 26 6M7 6h19v19" /></svg>
</a>
<style>
  .personal-space-entry {
    display: flex; align-items: center; justify-content: space-between; gap: 2rem;
    min-height: clamp(220px, 18vw, 280px); margin-top: 2rem;
    margin-bottom: calc(-1 * clamp(3.5rem, 6.5vw, 6rem));
    padding: 2rem clamp(1.5rem, 3vw, 2.5rem);
    color: var(--blue); background-color: var(--blue-pale); text-decoration: none;
    border: 1px solid var(--line);
    transition: background-color .3s ease, color .3s ease, border-color .3s ease;
  }
  .personal-space-entry strong { display: block; font: 500 clamp(2rem, 3vw, 2.65rem)/1.4 var(--serif); }
  .personal-space-entry small { display: block; margin-top: .35rem; color: inherit; opacity: .85; font-size: .92rem; }
  .personal-space-entry svg { width: 36px; height: 36px; flex: 0 0 36px; stroke: currentColor; stroke-width: 1.5; transition: transform .3s ease; }
  .personal-space-entry:focus-visible, .personal-space-entry:active {
    color: var(--white); background-color: var(--blue-deep); border-color: var(--blue-deep);
  }
  .personal-space-entry:focus-visible svg, .personal-space-entry:active svg { transform: translate(4px, -4px); }
  @media (hover: hover) and (pointer: fine) {
    .personal-space-entry:hover { color: var(--white); background-color: var(--blue-deep); border-color: var(--blue-deep); }
    .personal-space-entry:hover svg { transform: translate(4px, -4px); }
  }
  @media (max-width: 650px) { .personal-space-entry { min-height: 190px; gap: 1.25rem; padding: 1.5rem; } }
  @media (prefers-reduced-motion: reduce) { .personal-space-entry, .personal-space-entry svg { transition: none; } }
</style>
