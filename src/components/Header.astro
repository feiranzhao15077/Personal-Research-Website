---
import { getCollection } from 'astro:content';
const profile = (await getCollection('site'))[0].data;
---
<header class="site-header">
  <div class="shell header-inner">
    <a class="brand" href="/" aria-label={`${profile.publicName.zh} 研究主页`}><span class="brand-mark" aria-hidden="true">R<span class="brand-dot">.</span></span><span class="brand-name">{profile.publicName.zh}<span class="brand-context"> / Research Portfolio</span></span></a>
    <nav aria-label="主导航" class="site-nav">
      <a href="/#research-map">研究脉络</a>
      <a href="/#projects">项目</a>
      <a href="/#about">关于</a>
      <a href="/#materials">资料</a>
      <a href="/#contact">联系</a>
    </nav>
  </div>
</header>
