---
import type { CollectionEntry } from 'astro:content';
import { projectUrl } from '../lib/content';
import ResearchSummary from './ResearchSummary.astro';
import { Image } from 'astro:assets';
import droneBase from '../assets/research-drone-base.png';
import dronePropeller from '../assets/research-drone-propeller.png';

interface Props {
  map: CollectionEntry<'maps'>;
}

const { map } = Astro.props;

const mainNodes = map.data.nodes
  .filter((node) => node.trackId === 'electromagnetic')
  .sort((a, b) => a.sequence - b.sequence);

const branchNode = map.data.nodes.find((node) => node.trackId === 'autonomous');

const names: Record<string, string> = {
  'em-trace': 'EM-Trace',
  'lowalt-md': 'LowAlt-MD',
  emvision: 'EMvision',
  'quadcontrol-lab': 'QuadControl-Lab'
};

const phaseLabels: Record<string, { step: string; phase: string }> = {
  'em-trace': { step: 'PHASE 01', phase: '计算基底与信号链' },
  'lowalt-md': { step: 'PHASE 02', phase: '前向传播与相关' },
  emvision: { step: 'PHASE 03', phase: '逆向归因与边界' },
  'quadcontrol-lab': { step: 'PARALLEL', phase: '闭环动力学隔离' }
};

// Illustration coordinates only; these overlays are not research measurements.
const sketchRotors = [
  { cx: 307, cy: 321, rx: 187, ry: 130, pivotX: 308, pivotY: 300, diameter: 570, projection: .65, angle: -41 },
  { cx: 944, cy: 321, rx: 187, ry: 130, pivotX: 944, pivotY: 300, diameter: 570, projection: .65, angle: 41 },
  { cx: 264, cy: 848, rx: 189, ry: 161, pivotX: 267, pivotY: 815, diameter: 540, projection: .81, angle: 34 },
  { cx: 982, cy: 848, rx: 189, ry: 161, pivotX: 987, pivotY: 815, diameter: 540, projection: .81, angle: -34 },
];
---

<section class="blueprint-section" id="research-map" aria-labelledby="map-heading">
  <div class="shell">
    
    <div class="section-intro light-intro">
      <p class="eyebrow">01 / Research Blueprint</p>
      <h2 id="map-heading">研究坐标图谱</h2>
      <p>以第一性原理建模与受控审计为共同方法论，在电磁感知与自主系统两个领域建立的结构化探索路径。</p>
    </div>

    <div class="blueprint-container">
      <!-- Background Grid Pattern -->
      <div class="blueprint-bg"></div>

      <!-- Connecting Lines (SVG) -->
      <svg class="blueprint-lines" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
        <!-- Main Track Line -->
        <line x1="16%" y1="25%" x2="84%" y2="25%" stroke="#cbd5e1" stroke-width="2" stroke-dasharray="6 6" />
        <!-- Branch Line (Drops down from center) -->
        <path d="M 50% 25% L 50% 75%" fill="none" stroke="#cbd5e1" stroke-width="2" stroke-dasharray="6 6" />
      </svg>

      <div class="nodes-grid">
        <!-- Track 1: Electromagnetic progression -->
        {mainNodes.map((node, index) => {
          const isFlagship = node.projectId === 'emvision';
          const pInfo = phaseLabels[node.projectId];

          return (
            <div class={`b-node main-node node-${index + 1} gs-fade-up`}>
              <div class="node-indicator">
                <div class="inner-dot"></div>
              </div>
              <article class="b-card">
                <a href={projectUrl(node.projectId)} class="card-link">
                  <header class="card-header">
                    <span class="phase-step">{pInfo.step}</span>
                    {isFlagship && <span class="flagship-mark">★ FLAGSHIP</span>}
                  </header>
                  <h5 class="project-title">{names[node.projectId]}</h5><ResearchSummary projectId={node.projectId} compact />
                  <p class="project-phase">{pInfo.phase}</p>
                  <p class="q-text">{node.question.zh}</p>
                </a>
              </article>
            </div>
          );
        })}

        <figure class="map-aircraft">
          <div class="aircraft-drawing">
            <Image
              src={droneBase}
              alt="四旋翼无人机的手绘工程示意图"
              class="map-aircraft-image"
              width={720}
              widths={[240, 480, 720]}
              sizes="(max-width: 900px) 230px, (max-width: 1200px) 28vw, 360px"
              format="webp"
              loading="lazy"
              decoding="async"
            />
            <div class="aircraft-propellers" aria-hidden="true">
              {sketchRotors.map((rotor) => (
                <div class="propeller-plane" style={`--rotor-x: ${rotor.pivotX / 1254 * 100}%; --rotor-y: ${rotor.pivotY / 1254 * 100}%; --rotor-size: ${rotor.diameter / 1254 * 100}%; --rotor-projection: ${rotor.projection}; --rotor-angle: ${rotor.angle}deg;`}>
                  <Image
                    src={dronePropeller}
                    alt=""
                    class="aircraft-propeller"
                    data-rotor-angle={rotor.angle}
                    width={320}
                    widths={[160, 320]}
                    sizes="(max-width: 900px) 110px, 164px"
                    format="webp"
                    loading="eager"
                    decoding="async"
                  />
                </div>
              ))}
            </div>
            <svg class="aircraft-annotations" viewBox="0 0 1254 1254" fill="none" aria-hidden="true" focusable="false">
              <g class="aircraft-layer aircraft-coordinates">
                <path d="M 627 613 L 627 374 M 627 613 L 857 613 M 627 613 L 466 764" />
                <circle cx="627" cy="613" r="9" />
                <path d="M 617 390 L 627 374 L 637 390 M 841 603 L 857 613 L 841 623" />
              </g>
              <g class="aircraft-layer aircraft-propagation">
                <path d="M 425 361 Q 627 249 829 361 M 322 293 Q 627 102 932 293 M 220 229 Q 627 -42 1034 229" />
                <path d="M 307 321 L 627 613 L 944 321" stroke-dasharray="4 7" />
              </g>
              <g class="aircraft-layer aircraft-observation">
                <path d="M 513 511 V 446 H 578 M 678 446 H 743 V 511 M 743 698 V 763 H 678 M 578 763 H 513 V 698" />
                <circle cx="627" cy="605" r="16" />
                <path d="M 627 578 V 593 M 627 617 V 632 M 600 605 H 615 M 639 605 H 654" />
              </g>
              <g class="aircraft-layer aircraft-rotors">
                {sketchRotors.map(({ cx, cy, rx, ry }) => <ellipse cx={cx} cy={cy} rx={rx} ry={ry} />)}
              </g>
            </svg>
          </div>
          <figcaption>四旋翼工程草图 <span aria-hidden="true">·</span> 视觉示意</figcaption>
        </figure>

        <!-- Track 2: Autonomous Branch -->
        {branchNode && (
          <div class="b-node branch-node gs-fade-up">
            <div class="node-indicator auto-indicator">
              <div class="inner-dot"></div>
            </div>
            <article class="b-card auto-card">
              <a href={projectUrl(branchNode.projectId)} class="card-link">
                <header class="card-header">
                  <span class="phase-step auto-step">{phaseLabels[branchNode.projectId].step}</span>
                  <span class="branch-stamp">独立沙盒</span>
                </header>
                <h5 class="project-title">{names[branchNode.projectId]}</h5><ResearchSummary projectId={branchNode.projectId} compact />
                <p class="project-phase">{phaseLabels[branchNode.projectId].phase}</p>
                <p class="q-text">{branchNode.question.zh}</p>
              </a>
            </article>
          </div>
        )}

        <aside class="maxwell-notes" aria-label="麦克斯韦方程组">
          <div class="maxwell-equations">
            <div class="maxwell-row">
              <math class="maxwell-equation" aria-label="D 的散度等于自由电荷密度 rho">
                <mrow><mo>∇</mo><mo>·</mo><mi mathvariant="bold">D</mi><mo>=</mo><mi>ρ</mi></mrow>
              </math>
            </div>
            <div class="maxwell-row">
              <math class="maxwell-equation" aria-label="B 的散度等于零">
                <mrow><mo>∇</mo><mo>·</mo><mi mathvariant="bold">B</mi><mo>=</mo><mn>0</mn></mrow>
              </math>
            </div>
            <div class="maxwell-row">
              <math class="maxwell-equation" aria-label="E 的旋度等于 B 对时间偏导数的负值">
                <mrow><mo>∇</mo><mo>×</mo><mi mathvariant="bold">E</mi><mo>=</mo><mo>−</mo><mfrac><mrow><mo>∂</mo><mi mathvariant="bold">B</mi></mrow><mrow><mo>∂</mo><mi>t</mi></mrow></mfrac></mrow>
              </math>
            </div>
            <div class="maxwell-row">
              <math class="maxwell-equation" aria-label="H 的旋度等于自由电流密度 J 加 D 对时间的偏导数">
                <mrow><mo>∇</mo><mo>×</mo><mi mathvariant="bold">H</mi><mo>=</mo><mi mathvariant="bold">J</mi><mo>+</mo><mfrac><mrow><mo>∂</mo><mi mathvariant="bold">D</mi></mrow><mrow><mo>∂</mo><mi>t</mi></mrow></mfrac></mrow>
              </math>
            </div>
          </div>
        </aside>
      </div>

    </div>

    <!-- Qualifier -->
    <div class="audit-qualifier gs-fade-up">
      <span class="aq-label">RELATIONSHIP AUDIT</span>
      <p class="aq-text">节点表征物理维度与认知视角的演进，<strong>不代表</strong>软件工程中的直接代码依赖或数据流向。</p>
    </div>

  </div>
</section>

<style>
  /* =========================================================
     RESEARCH BLUEPRINT (Light/Structured Theme)
     ========================================================= */

  .blueprint-section {
    position: relative;
    background: var(--paper); /* Same as Hero */
    padding-block: clamp(5rem, 10vw, 8rem);
    border-top: 1px solid rgba(0,0,0,0.05);
  }

  .light-intro {
    text-align: center;
    max-width: 600px;
    margin: 0 auto 4rem auto;
  }
  .light-intro .eyebrow {
    color: var(--blue);
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.85rem;
    letter-spacing: 0.1em;
    margin-bottom: 0.5rem;
  }
  .light-intro h2 {
    font-size: clamp(2rem, 3vw, 2.5rem);
    color: var(--ink);
    margin-bottom: 1rem;
  }
  .light-intro p {
    color: var(--ink-soft);
    line-height: 1.6;
  }

  /* --- Container & Background --- */
  .blueprint-container {
    position: relative;
    width: 100%;
    padding: 3rem 0;
    margin-bottom: 3rem;
  }

  .blueprint-bg {
    position: absolute;
    inset: 0;
    background-image: 
      linear-gradient(rgba(99, 179, 237, 0.1) 1px, transparent 1px),
      linear-gradient(90deg, rgba(99, 179, 237, 0.1) 1px, transparent 1px);
    background-size: 40px 40px;
    background-position: center;
    z-index: 0;
    mask-image: radial-gradient(circle at center, black 40%, transparent 80%);
    -webkit-mask-image: radial-gradient(circle at center, black 40%, transparent 80%);
  }

  .blueprint-lines {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    pointer-events: none;
  }

  /* --- Grid Layout --- */
  .nodes-grid {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: auto auto;
    gap: 4rem 2rem;
    max-width: 1100px;
    margin: 0 auto;
  }

  /* Node Placements */
  .main-node.node-1 { grid-column: 1; grid-row: 1; }
  .main-node.node-2 { grid-column: 2; grid-row: 1; }
  .main-node.node-3 { grid-column: 3; grid-row: 1; }
  .branch-node      { grid-column: 2; grid-row: 2; } /* Placed under Phase 2 for symmetry */

  /* A typeset margin note balances the engineering sketch across the branch. */
  .maxwell-notes {
    grid-column: 3;
    grid-row: 2;
    align-self: center;
    min-width: 0;
    padding: .75rem 0 .75rem 2.75rem;
    border-left: 1px solid color-mix(in srgb, var(--blue) 22%, transparent);
    color: var(--blue);
  }
  .maxwell-equations { display: grid; gap: 1.75rem; }
  .maxwell-row {
    position: relative;
    display: grid;
    width: fit-content;
    max-width: 100%;
    transition: transform .25s cubic-bezier(.16, 1, .3, 1);
  }
  .maxwell-equation {
    display: block;
    width: fit-content;
    max-width: 100%;
    font-family: 'Cambria Math', 'STIX Two Math', serif;
    font-size: clamp(1.25rem, 1.8vw, 1.6rem);
    transform-origin: center;
    transition: color .25s ease;
  }
  .blueprint-container:has(.card-link:focus-visible) .maxwell-equation { color: var(--ink); }
  .maxwell-converging .maxwell-equation { opacity: 0; }
  @media (hover: hover) and (pointer: fine) {
    .blueprint-container:has(.card-link:hover) .maxwell-equation { color: var(--ink); }
    .maxwell-row:hover { transform: translate(3px, -2px); }
    .maxwell-row:hover .maxwell-equation { color: var(--ink); }
  }
  .maxwell-row:active .maxwell-equation { color: var(--ink); }
  :global(.maxwell-flight-layer) {
    position: fixed;
    inset: 0;
    z-index: 10000;
    pointer-events: none;
    overflow: hidden;
    color: var(--blue);
  }
  :global(.maxwell-flight-equation) { position: absolute; margin: 0; will-change: transform, opacity; }
  :global(.maxwell-convergence-point) {
    position: absolute;
    width: 14px;
    height: 14px;
    margin: -7px 0 0 -7px;
    border: 1px solid currentColor;
    border-radius: 50%;
    opacity: 0;
  }

  /* The supplied pencil drawing occupies the lower-left open grid cell. */
  .map-aircraft {
    grid-column: 1;
    grid-row: 2;
    align-self: center;
    width: 100%;
    max-width: 360px;
    margin: 0 auto;
  }
  .aircraft-drawing { position: relative; background: var(--paper); isolation: isolate; }
  .map-aircraft-image {
    display: block;
    width: 100%;
    height: auto;
    opacity: .8;
    mix-blend-mode: multiply;
    transition: opacity .3s ease;
  }
  .aircraft-propellers { position: absolute; inset: 0; pointer-events: none; }
  .propeller-plane {
    position: absolute;
    left: var(--rotor-x);
    top: var(--rotor-y);
    width: var(--rotor-size);
    aspect-ratio: 1;
    transform: translate(-50%, -50%) scaleY(var(--rotor-projection));
  }
  .aircraft-propeller {
    display: block;
    width: 100%;
    height: auto;
    transform: rotate(var(--rotor-angle));
    transform-origin: center;
    opacity: .84;
    transition: opacity .2s ease;
  }
  .rotors-running .aircraft-propeller { will-change: transform; opacity: .72; }
  .map-aircraft figcaption {
    margin-top: .5rem;
    color: var(--ink-soft);
    text-align: center;
    font-size: .75rem;
    letter-spacing: .04em;
  }
  .aircraft-annotations {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    color: var(--blue);
  }
  .aircraft-layer {
    stroke: currentColor;
    stroke-width: 1.2;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: 0;
    transition: opacity .28s ease;
  }
  .aircraft-layer > * { vector-effect: non-scaling-stroke; }
  .blueprint-container:has(.node-1:focus-within) .aircraft-coordinates,
  .blueprint-container:has(.node-2:focus-within) .aircraft-propagation,
  .blueprint-container:has(.node-3:focus-within) .aircraft-observation,
  .blueprint-container:has(.branch-node:focus-within) .aircraft-rotors { opacity: .85; }
  .blueprint-container:has(.b-node:focus-within) .map-aircraft-image { opacity: .96; }
  @media (hover: hover) and (pointer: fine) {
    .blueprint-container:has(.node-1 .card-link:hover) .aircraft-coordinates,
    .blueprint-container:has(.node-2 .card-link:hover) .aircraft-propagation,
    .blueprint-container:has(.node-3 .card-link:hover) .aircraft-observation,
    .blueprint-container:has(.branch-node .card-link:hover) .aircraft-rotors { opacity: .85; }
    .blueprint-container:has(.card-link:hover) .map-aircraft-image { opacity: .96; }
  }
  @media (prefers-reduced-motion: reduce) {
    .aircraft-layer, .map-aircraft-image, .aircraft-propeller { transition: none; }
    .maxwell-equation, .maxwell-row { transition: none; }
    .maxwell-row:hover { transform: none; }
  }

  .b-node {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: left;
  }

  /* Node Indicator (Dots on the lines) */
  .node-indicator {
    width: 24px;
    height: 24px;
    background: var(--paper);
    border: 2px solid var(--blue);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.5rem;
    z-index: 5;
    position: relative;
    box-shadow: 0 0 0 4px var(--paper); /* Cut out line behind */
  }
  .inner-dot {
    width: 10px;
    height: 10px;
    background: var(--blue);
    border-radius: 50%;
  }

  .auto-indicator {
    border-color: #48bb78;
  }
  .auto-indicator .inner-dot {
    background: #48bb78;
  }

  /* --- Cards --- */
  .b-card {
    position: relative;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 1.5rem;
    width: 100%;
    box-shadow: 0 4px 15px rgba(0,0,0,0.03);
    transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275), box-shadow 0.3s ease, border-color 0.3s ease;
    overflow: hidden;
    --accent: rgba(99, 179, 237, 1); /* Blue for main nodes */
  }

  .auto-card {
    --accent: rgba(72, 187, 120, 1); /* Green for branch node */
  }

  /* Soft Inner Glow and Border Highlight */
  .b-card::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    box-shadow: inset 0 0 0 1px transparent;
    transition: box-shadow 0.4s ease;
    z-index: 1;
  }

  /* Sweeping Scanline Effect */
  .b-card::after {
    content: '';
    position: absolute;
    top: 0;
    left: -150%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, color-mix(in srgb, var(--accent) 15%, transparent), transparent);
    transform: skewX(-25deg);
    pointer-events: none;
    z-index: 0;
  }

  .b-card:hover, .b-card:focus-within {
    transform: translateY(-8px);
    box-shadow: 0 15px 35px rgba(0,0,0,0.06), 0 5px 15px color-mix(in srgb, var(--accent) 15%, transparent);
    border-color: transparent; /* Hide original border to let pseudo-element shine */
  }

  .b-card:hover::before, .b-card:focus-within::before {
    box-shadow: inset 0 0 0 2px color-mix(in srgb, var(--accent) 60%, transparent), 
                inset 0 0 20px color-mix(in srgb, var(--accent) 10%, transparent);
  }

  .b-card:hover::after {
    animation: scan-light 0.8s ease-out forwards;
  }

  @keyframes scan-light {
    0% { left: -150%; }
    100% { left: 200%; }
  }

  .card-link {
    text-decoration: none;
    color: inherit;
    display: block;
    height: 100%;
    position: relative;
    z-index: 2; /* Content above the scanline */
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.75rem;
  }
  
  .phase-step {
    color: var(--blue);
    font-weight: 600;
    letter-spacing: 0.05em;
  }
  
  .auto-step {
    color: #48bb78;
  }

  .flagship-mark {
    background: var(--ink);
    color: #fff;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    font-weight: 600;
    font-size: 0.65rem;
  }

  .branch-stamp {
    border: 1px solid #48bb78;
    color: #48bb78;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
  }

  .project-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--ink);
    margin-bottom: 0.25rem;
    font-family: var(--serif);
  }

  .project-phase {
    font-size: 0.85rem;
    color: var(--ink-soft);
    margin-bottom: 1rem;
    font-weight: 500;
  }

  .q-text {
    font-size: 0.9rem;
    color: var(--ink-light);
    line-height: 1.5;
    border-top: 1px solid #f1f5f9;
    padding-top: 1rem;
  }

  /* Qualifier */
  .audit-qualifier {
    text-align: center;
    max-width: 600px;
    margin: 0 auto;
    padding: 1.5rem;
    background: #f8fafc;
    border: 1px dashed #cbd5e1;
    border-radius: 6px;
  }
  .aq-label {
    display: block;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.75rem;
    color: var(--ink-soft);
    margin-bottom: 0.5rem;
  }
  .aq-text {
    font-size: 0.85rem;
    color: var(--ink-light);
    line-height: 1.5;
  }
  .aq-text strong {
    color: #e53e3e;
  }

  /* Responsive Adjustments */
  @media (max-width: 900px) {
    .nodes-grid {
      grid-template-columns: 1fr;
      grid-template-rows: auto;
      gap: 3rem;
    }
    .main-node.node-1 { grid-column: 1; grid-row: 1; }
    .main-node.node-2 { grid-column: 1; grid-row: 2; }
    .main-node.node-3 { grid-column: 1; grid-row: 3; }
    .map-aircraft     { grid-column: 1; grid-row: 4; max-width: 230px; }
    .branch-node      { grid-column: 1; grid-row: 5; }
    .maxwell-notes    { grid-column: 1; grid-row: 6; width: 100%; max-width: 420px; margin: 0 auto; padding: 1.5rem 0 0 1rem; border-left: 0; border-top: 1px solid color-mix(in srgb, var(--blue) 22%, transparent); }
    .maxwell-equations { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.25rem .75rem; }
    .maxwell-equation { font-size: 1.25rem; }
    
    .blueprint-lines {
      display: none; /* Hide SVG lines on mobile, rely on cards */
    }
    .node-indicator {
      margin-bottom: 1rem;
    }
  }
  @media (max-width: 360px) {
    .maxwell-equations { grid-template-columns: 1fr; }
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { setupRotorInteraction } from '../lib/rotor-interaction';
  import { setupMaxwellTransition } from '../lib/maxwell-transition';

  gsap.registerPlugin(ScrollTrigger);

  const initMap = () => {
    // Simple fade up for elements
    gsap.utils.toArray('.gs-fade-up').forEach((el: any, i) => {
      gsap.fromTo(el,
        { y: 30, opacity: 0 },
        {
          y: 0,
          opacity: 1,
          duration: 0.8,
          ease: "power2.out",
          scrollTrigger: {
            trigger: el,
            start: "top 85%",
            toggleActions: "play none none reverse"
          }
        }
      );
    });

    // Draw lines animation
    gsap.fromTo(".blueprint-lines line, .blueprint-lines path",
      { strokeDasharray: "0 1000" },
      {
        strokeDasharray: "6 6",
        duration: 2,
        ease: "power2.out",
        scrollTrigger: {
          trigger: ".blueprint-container",
          start: "top 70%"
        }
      }
    );
  };

  // Run on first load
  initMap();
  const rotorMap = document.querySelector<HTMLElement>('#research-map');
  if (rotorMap) {
    setupRotorInteraction(rotorMap);
    setupMaxwellTransition(rotorMap);
  }
  
  // Re-run on View Transitions
  document.addEventListener('astro:page-load', initMap);
</script>
