---
import '../styles/global.css';
import { getCollection } from 'astro:content';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FigureViewer from '../components/FigureViewer.astro';
import { sitePath } from '../lib/urls';
interface Props { title: string; description: string; path?: string; }
const { title, description, path = '/' } = Astro.props;
const profile = (await getCollection('site'))[0].data;
const isDraft = import.meta.env.RELEASE_MODE !== 'production';
const canonical = new URL(sitePath(path), Astro.site).toString();
const pageTitle = `${title} · ${profile.publicName.zh}`;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <meta name="description" content={description} />
    {(isDraft || path === '/404.html') && <meta name="robots" content="noindex,nofollow" />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={sitePath('/favicon.svg')} type="image/svg+xml" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">跳转到正文</a>
    <Header />
    <main id="main"><slot /></main>
    <Footer />
    <FigureViewer />
  </body>
</html>
