---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
interface Props { title: string; description: string; path?: string; }
const { title, description, path = '/' } = Astro.props;
const origin = import.meta.env.PUBLIC_SITE_URL || 'https://research.example.invalid';
const isPlaceholder = origin.includes('.invalid');
const canonical = new URL(path, origin).toString();
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <meta name="description" content={description} />
    {isPlaceholder && <meta name="robots" content="noindex,nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title} · Research Portfolio</title>
  </head>
  <body>
    <a class="skip-link" href="#main">跳转到正文</a>
    <Header />
    <main id="main"><slot /></main>
    <Footer />
  </body>
</html>
