{
  "name": "personal-research-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "preview": "astro preview",
    "typecheck": "astro check",
    "validate:content": "node scripts/validate-content.mjs",
    "validate:public": "node scripts/validate-public-content.mjs",
    "validate:dist": "node scripts/validate-public-content.mjs --dist",
    "validate:release": "node scripts/validate-release.mjs --full",
    "validate:initial": "node scripts/validate-release.mjs --initial",
    "predeploy": "node scripts/predeploy.mjs",
    "predeploy:initial": "node scripts/predeploy.mjs --initial",
    "dry-run": "node scripts/dry-run-deployment.mjs",
    "build": "node scripts/build-site.mjs",
    "build:astro": "astro build",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "build:release": "node scripts/build-release.mjs",
    "validate:links": "node scripts/validate-links.mjs",
    "validate:external": "node scripts/validate-links.mjs --external"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "astro": "6.4.8",
    "gsap": "^3.15.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@playwright/test": "1.63.0",
    "typescript": "5.9.3"
  }
}
