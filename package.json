{
  "name": "personal-research-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "preview": "astro preview",
    "typecheck": "astro check",
    "validate:content": "node scripts/validate-content.mjs",
    "validate:public": "node scripts/validate-public-content.mjs",
    "validate:dist": "node scripts/validate-public-content.mjs --dist",
    "build": "npm run validate:content && npm run validate:public && astro build && npm run validate:dist",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "build:release": "node scripts/build-release.mjs",
    "validate:links": "node scripts/validate-links.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "astro": "6.4.8",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@playwright/test": "1.63.0",
    "typescript": "5.9.3"
  }
}
